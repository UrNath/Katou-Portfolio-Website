# Paste the real values into Vercel → the Production environment row.
# Do not commit them. KEYSTATIC_SECRET must be at least 32 characters.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Studio sign-in. When both are set, /admin requires a GitHub login as UrNath.
# OAuth App (not the Keystatic GitHub App): https://github.com/settings/applications/new
# Callback: https://nassukatou-site.vercel.app/api/admin/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. Encrypts the sign-in cookie. Defaults to GITHUB_CLIENT_SECRET.
ADMIN_SESSION_SECRET=
# Optional. Used only while GitHub sign-in above is not configured.
ADMIN_GITHUB_TOKEN=
