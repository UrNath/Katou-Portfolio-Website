---
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import chibi from '../assets/character/katou-chibi.webp';
import { site } from '../data/site';
import { status, labelFor } from '../data/status';
import { hubClips, loadClips } from '../lib/clips';
import { loadService } from '../lib/services';
import { cleanTitle, playAttrs } from '../lib/site-data';

const clips = await loadClips();
const featured = hubClips(clips).slice(0, 7);
const start = Math.max(0, featured.findIndex((clip) => clip.heroFeatured));
const editing = await loadService('editing');
const turnaround = editing.data.compare.find((row) => row.feature === 'Turnaround')?.values[0]?.replace(/ days?$/, ' d').replace(' to ', '–');
const tagline = site.role.replace(/^Short-form\s+/i, '');
const art = site.characterArt;
---
<Site page="home">
  <main class="page on" id="p-home">
    <section class="screen dots" id="top" aria-labelledby="intro-title">
      <div class="bg-slab" aria-hidden="true"></div>
      <p class="ghost-name" aria-hidden="true">Katou</p>
      <div class="wrap screen-grid">
        <div class="hero-copy">
          <p class="kicker ui" data-rise><span class="slashes"></span><span>Professor Number <b>67</b></span><span class="hatch"></span></p>
          <p class="pre" data-rise style="--i:1">Meet the editor!</p>
          <h1 class="name" id="intro-title" data-rise style="--i:2"><span>Katou</span></h1>
          <div class="tags" data-rise style="--i:3"><span class="t1">Video editor</span><span class="t2">UI/UX Developer</span>{status.editing !== 'closed' && <span class="t3">★ Commissions open</span>}</div>
          <p class="tagline" data-rise style="--i:4">{tagline}</p>
          <div class="skills" data-rise style="--i:5" aria-label="Services">
            <a class="skill" href="/pricing#ed-sec"><span class="dia"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"/></svg></span><b>Editing<small>{labelFor(status.editing)}</small></b></a>
            <a class="skill" href="/pricing#web-sec"><span class="dia"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg></span><b>UI/UX Developer<small>{labelFor(status.webDesign)}</small></b></a>
          </div>
          <div class="actions" data-rise style="--i:6">
            <a class="btn" href="/works"><span class="tri"></span>View works</a>
            <a class="btn peach" href="/contact">Contact</a>
          </div>
          <a class="scroll-cue ui" href="#feat-sec" data-rise style="--i:7">Scroll to see my edits <i></i></a>
        </div>
        <div class="art-stage" data-rise style="--i:2" data-float>
          <span class="hatch decal-a" aria-hidden="true"></span>
          <div class="katou-frame">
            <div class="card float-back" aria-hidden="true"></div>
            <Image class="rim float-model" src={chibi} alt={art.alt} widths={[440, 880]} sizes="(min-width: 900px) 440px, 240px" loading="eager" fetchpriority="high" />
            {art.artist && <p class="credit ui">Art illust: {art.artist.toLowerCase()}</p>}
          </div>
        </div>
      </div>
    </section>

    <section class="feat" id="feat-sec" aria-labelledby="featured-title">
      <div class="wrap">
        <div>
          <p class="sec-no" data-rise><b>02</b> Featured</p>
          <h2 class="h2" id="featured-title" data-rise style="--i:1">Featured works</h2>
          <p class="sub" data-rise style="--i:2">Shorts for TikTok and YouTube, with dynamic subtitles, motion graphics, and comedic timing.</p>
          <div class="feat-cta" data-rise style="--i:3"><a class="btn gold" href="/works">See all works →</a></div>
        </div>
        <div class="carousel" data-rise style="--i:2" data-start={start}>
          <div class="car-head ui"><span>Now playing</span><span class="car-count" aria-label="Clip position"><b id="car-num">{String(start + 1).padStart(2, '0')}</b> / {String(featured.length).padStart(2, '0')}</span></div>
          <div class="car-track" id="car">
            {featured.map((clip, i) => (
              <button type="button" class="car-card" data-i={i} data-preview-off {...playAttrs(clip)} data-play="off" aria-label={cleanTitle(clip.title)}>
                <span class="halo"></span><span class="pf"><img src={clip.poster} alt="" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" /></span><span class="frame"></span>
              </button>
            ))}
          </div>
          <div class="car-foot">
            <p class="car-title" id="car-title"></p>
            <div class="pips" id="pips">
              {featured.map((_, i) => <button type="button" aria-label={`Clip ${i + 1}`} data-i={i}></button>)}
            </div>
            <div class="arrows car-arrows"><button type="button" id="car-prev" aria-label="Previous clip">‹</button><button type="button" id="car-next" aria-label="Next clip">›</button></div>
          </div>
        </div>
      </div>
    </section>

    <section class="about" id="about-sec" aria-labelledby="about-title">
      <div class="wrap">
        {site.aboutVideo.src ? (
          <div class="vid"><video src={site.aboutVideo.src} poster={site.aboutVideo.poster || undefined} muted loop playsinline controls preload="metadata" aria-label="About Katou video"></video></div>
        ) : (
          <div class="vid" role="img" aria-label="Placeholder: About video coming soon">
            <span class="rec ui">Rec</span><span class="tc ui">00:00:00:00</span>
            <div class="mid"><span class="dia"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span><span class="ui" style="color:var(--mute)">About video coming soon</span></div>
          </div>
        )}
        <div>
          <p class="sec-no"><b>03</b> Profile</p>
          <h2 class="h2" id="about-title">About Katou</h2>
          <p class="body">{site.description}</p>
          <dl class="statline ui">
            <div><dt>Edits</dt><dd>{clips.length}</dd></div>
            {turnaround && <div><dt>Turnaround</dt><dd>{turnaround}</dd></div>}
          </dl>
        </div>
      </div>
    </section>

    <section class="cta-band" id="home-contact" aria-labelledby="contact-title">
      <div class="wrap">
        <p class="sec-no"><b>04</b> Contact</p>
        <h2 class="name" id="contact-title">Let’s make <em>something.</em></h2>
        <a class="btn gold" href="/contact">Contact</a>
      </div>
    </section>
  </main>
</Site>

<script>
  // Featured carousel: a continuous "position" (in cards) drives every card, so mouse, touch and pen can drag it
  // with the cursor, release with inertia and settle on a card. The centre card plays and pauses in place.
  const car = document.querySelector<HTMLElement>('.carousel');
  if (car) {
    const cards = Array.from(car.querySelectorAll<HTMLElement>('.car-card'));
    const pips = Array.from(car.querySelectorAll<HTMLButtonElement>('#pips button'));
    const title = car.querySelector<HTMLElement>('#car-title')!;
    const counter = car.querySelector<HTMLElement>('#car-num')!;
    const track = car.querySelector<HTMLElement>('#car')!;
    const n = cards.length;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let fi = Number(car.dataset.start) || 0;
    let pos = fi, vel = 0, target = fi;
    let dragging = false, raf = 0, last = 0;
    let down: { id: number; x: number; pos0: number; started: boolean; samples: [number, number][] } | undefined;
    let suppress = false;

    // Card poses come from CSS variables (desktop and phone differ), interpolated between whole-card steps.
    const css = getComputedStyle(car);
    const num = (name: string, fallback: number) => parseFloat(css.getPropertyValue(name)) || fallback;
    const wrap = (d: number) => { d = ((d % n) + n) % n; return d > n / 2 ? d - n : d; };
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    function pose(d: number) {
      const a = Math.min(Math.abs(d), 3), sgn = d < 0 ? -1 : 1, lite = document.documentElement.classList.contains('fx-lite');
      const cx1 = num('--cx1', 62), cx2 = num('--cx2', 110), cs1 = num('--cs1', .82), cs2 = num('--cs2', .66), o2 = num('--c2o', 1);
      // [x %, rotateY deg, scale, brightness, saturate, opacity] at 0, 1, 2 and 3 cards from the centre.
      const K = lite
        ? [[0, 0, 1.08, 1, 1, 1], [cx1, 28, cs1, 1, 1, .5], [cx2, 35, cs2, 1, 1, .5 * o2], [cx2, 35, .5, 1, 1, 0]]
        : [[0, 0, 1.08, 1, 1, 1], [cx1, 28, cs1, .5, .6, 1], [cx2, 35, cs2, .3, 1, o2], [cx2, 35, .5, .3, 1, 0]];
      const i = Math.min(2, Math.floor(a)), t = a - i, f = (k: number) => lerp(K[i][k], K[i + 1][k], t);
      return { x: sgn * f(0), rot: -sgn * f(1), scale: f(2), br: f(3), sat: f(4), op: f(5) };
    }
    function render() {
      cards.forEach((card, i) => {
        const d = wrap(i - pos), q = pose(d), s = card.style;
        s.transition = 'translate .3s cubic-bezier(.2, .8, .2, 1)';
        s.transform = `translateX(${q.x.toFixed(2)}%) rotateY(${q.rot.toFixed(2)}deg) scale(${q.scale.toFixed(3)})`;
        s.filter = q.br === 1 && q.sat === 1 ? 'none' : `brightness(${q.br.toFixed(2)}) saturate(${q.sat.toFixed(2)})`;
        s.opacity = q.op.toFixed(3);
        s.zIndex = String(Math.abs(d) < .5 ? 3 : Math.abs(d) < 1.5 ? 2 : Math.abs(d) < 2.5 ? 1 : 0);
        s.pointerEvents = q.op < .05 ? 'none' : '';
      });
    }
    const stopMedia = (except?: HTMLElement) => cards.forEach((card) => {
      if (card === except) return;
      const v = card.querySelector<HTMLVideoElement>('video.pv');
      if (v) { v.pause(); v.remove(); }
      card.removeAttribute('data-playing');
    });
    // Title and counter re-run a short slide/fade from the side the stack moved toward.
    const swap = (el: HTMLElement, dir: number) => {
      el.style.setProperty('--tx', `${dir > 0 ? 28 : -28}px`);
      el.classList.remove('in'); void el.offsetWidth; el.classList.add('in');
    };
    function draw(dir = 0) {
      cards.forEach((card, i) => {
        let d = (i - fi + n) % n; if (d > n / 2) d -= n;
        card.className = `car-card c${Math.max(-3, Math.min(3, d))}`;
        card.dataset.play = d === 0 ? '' : 'off';
        card.tabIndex = Math.abs(d) <= 1 ? 0 : -1;
        card.setAttribute('aria-hidden', String(Math.abs(d) > 1));
      });
      pips.forEach((p, i) => p.setAttribute('aria-current', String(i === fi)));
      const text = cards[fi]?.dataset.title ?? '';
      if (title.textContent !== text) { title.textContent = text; if (dir) swap(title, dir); }
      const label = String(fi + 1).padStart(2, '0');
      if (counter.textContent !== label) { counter.textContent = label; if (dir) swap(counter, dir); }
      stopMedia(cards[fi]);
    }
    // Spring toward `target`, starting with the release velocity: it carries on, slows smoothly and settles on a card.
    const W = 13;
    function tick(now: number) {
      const dt = Math.min(.05, (now - last) / 1000 || .016); last = now;
      if (!dragging) {
        const steps = Math.ceil(dt / .008), h = dt / steps;
        for (let k = 0; k < steps; k++) { vel += (-W * W * (pos - target) - 2 * W * vel) * h; pos += vel * h; }
        if (Math.abs(pos - target) < .002 && Math.abs(vel) < .02) { pos = target; vel = 0; }
      }
      const r = ((Math.round(pos) % n) + n) % n;
      if (r !== fi) { const d = wrap(r - fi); fi = r; draw(d); }
      render();
      if (dragging || pos !== target || vel !== 0) raf = requestAnimationFrame(tick);
      else { raf = 0; delete car!.dataset.moving; }
    }
    const kick = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); } };
    function go(i: number) {
      const nearest = Math.round(pos);
      target = nearest + wrap(i - nearest);
      if (reduced.matches) { pos = target; vel = 0; const d = wrap(target - fi); fi = ((target % n) + n) % n; draw(d); render(); return; }
      car!.dataset.moving = '';
      kick();
    }
    draw(); render();

    // Click: a side card steps to the centre; the centre card plays and pauses in place (a drag never counts as a click).
    track.addEventListener('click', (e) => {
      if (suppress) { suppress = false; e.stopPropagation(); e.preventDefault(); return; }
      const b = (e.target as Element).closest<HTMLElement>('.car-card');
      if (!b) return;
      e.stopPropagation(); e.preventDefault();
      if (Number(b.dataset.i) !== fi) { go(Number(b.dataset.i)); return; }
      const box = b.querySelector<HTMLElement>('.pf');
      if (!box || !b.dataset.preview) return;
      let v = box.querySelector<HTMLVideoElement>('video.pv');
      if (!v) {
        v = document.createElement('video');
        v.src = b.dataset.preview; v.poster = b.dataset.poster ?? ''; v.loop = true; v.playsInline = true; v.className = 'pv';
        v.addEventListener('pause', () => b.removeAttribute('data-playing'));
        v.addEventListener('play', () => b.setAttribute('data-playing', ''));
        box.append(v);
      }
      if (v.paused) v.play().catch(() => { v!.muted = true; v!.play().catch(() => {}); });
      else v.pause();
    }, true);
    pips.forEach((p, i) => p.addEventListener('click', () => go(i)));
    car.querySelector('#car-prev')!.addEventListener('click', () => go(fi - 1));
    car.querySelector('#car-next')!.addEventListener('click', () => go(fi + 1));
    car.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault(); go(fi + (e.key === 'ArrowRight' ? 1 : -1));
    });

    // Drag (pointer events: mouse, touch and pen). A press only becomes a drag after a few pixels, so plain clicks still work.
    track.style.touchAction = 'pan-y';
    track.addEventListener('dragstart', (e) => e.preventDefault());
    const pitch = () => (cards[0].offsetWidth * (track.getBoundingClientRect().width / track.offsetWidth || 1) * num('--cx1', 62)) / 100;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      suppress = false;
      down = { id: e.pointerId, x: e.clientX, pos0: pos, started: false, samples: [[e.timeStamp, pos]] };
    });
    track.addEventListener('pointermove', (e) => {
      if (!down || e.pointerId !== down.id) return;
      const dx = e.clientX - down.x;
      if (!down.started) {
        if (Math.abs(dx) < 6) return;
        down.started = true; dragging = true; vel = 0;
        track.setPointerCapture(e.pointerId);
        car.dataset.moving = '';
        kick();
      }
      pos = down.pos0 - dx / pitch();
      down.samples.push([e.timeStamp, pos]);
      while (down.samples.length > 2 && e.timeStamp - down.samples[0][0] > 100) down.samples.shift();
    });
    const release = (e: PointerEvent) => {
      if (!down || e.pointerId !== down.id) return;
      const d = down; down = undefined;
      if (!d.started) return;
      dragging = false;
      suppress = true; setTimeout(() => { suppress = false; }, 80);
      const [t0, p0] = d.samples[0], [t1, p1] = d.samples[d.samples.length - 1];
      const fast = e.type === 'pointerup' && e.timeStamp - t1 < 80 && t1 > t0;
      vel = fast ? Math.max(-8, Math.min(8, ((p1 - p0) / (t1 - t0)) * 1000)) : 0;
      if (reduced.matches) { target = Math.round(pos); pos = target; vel = 0; render(); }
      else target = Math.round(pos + vel * .25);
      kick();
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);
  }
</script>
