---
import { Image } from 'astro:assets';
import BaseLayout from '../components/BaseLayout.astro';
import SiteIntro from '../components/SiteIntro.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import StatusChip from '../components/StatusChip.astro';
import ClipPreview from '../islands/ClipPreview';
import ClipViewer from '../islands/ClipViewer';
import chibi from '../assets/character/katou-chibi.webp';
import { site } from '../data/site';
import { status } from '../data/status';
import { heroReel, hubClips, loadClips, toViewerClip } from '../lib/clips';
import { loadService } from '../lib/services';

const clips = await loadClips();
const featured = hubClips(clips);
const { hero } = heroReel(clips);
const art = site.characterArt;

const viewerClips = featured;
const editing = await loadService('editing');
const turnaround = editing.data.compare.find((row) => row.feature === 'Turnaround')?.values[0]?.replace(/ days?$/, ' d').replace(' to ', '–');
const tagline = site.role.replace(/^Short-form\s+/i, '');
---
<BaseLayout>
  <SiteIntro />
  <script is:inline>
    // Reveals are opt-in: content stays visible without scripting and for reduced motion.
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('reveal-ready');
    }
  </script>
  <div class="pc-home">
    <section class="pc-screen pc-fit pc-hero" id="home" aria-labelledby="intro-title">
      <span class="pc-blob pc-blob-peach" aria-hidden="true"></span>
      <span class="pc-blob pc-blob-gold" aria-hidden="true"></span>
      <span class="sk-slab" aria-hidden="true"></span>
      <span class="sk-ghost" aria-hidden="true">Katou</span>
      <div class="pc-art">
        <div class="pc-figure">
          <div class="pc-card" aria-hidden="true"></div>
          {art.enabled && (
            <div class="pc-pop">
              <Image class="pc-oc" src={chibi} alt={art.alt} widths={[420, 698]} sizes="(min-width: 900px) 520px, 80vw" loading="eager" fetchpriority="high" />
            </div>
          )}
          {art.enabled && art.artist && <p class="pc-credit">ART ILLUST: {art.artist}</p>}
          <span class="sk-hatch sk-decal" aria-hidden="true"></span>
        </div>
      </div>
      <div class="pc-hero-copy">
        <p class="sk-kicker" data-reveal><span class="sk-slashes" aria-hidden="true"></span><span>Professor Number <b>67</b></span><span class="sk-hatch" aria-hidden="true"></span></p>
        <h1 id="intro-title" data-reveal style="--i:1"><span class="sk-pre">Meet the Editor!</span> <span class="sk-name">Katou</span></h1>
        <p class="sk-tags" data-reveal style="--i:2">
          <span class="t1">Video editor</span><span class="t2">UI/UX Developer</span>{status.editing !== 'closed' && <span class="t3">★ Commissions open</span>}
        </p>
        <p class="pc-tagline" data-reveal style="--i:2">{tagline}</p>
        <ul class="sk-skills" data-reveal style="--i:3" aria-label="Services">
          <li><a class="sk-skill" href="/pricing#editing"><span class="sk-dia" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12"/></svg></span><b>Editing<small><StatusChip status={status.editing} /></small></b></a></li>
          <li><a class="sk-skill" href="/pricing#web-design"><span class="sk-dia" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg></span><b>UI/UX Developer<small><StatusChip status={status.webDesign} /></small></b></a></li>
        </ul>
        <div class="pc-actions" data-reveal style="--i:4">
          <a class="pc-btn pc-btn-white" href="/works"><span class="sk-tri" aria-hidden="true"></span>View Works</a>
          <a class="pc-btn pc-btn-peach" href="/contact">Contact</a>
        </div>
        <a class="pc-scroll" href="#featured" data-reveal style="--i:5" aria-label="Scroll down to see featured works">
          <span class="pc-scroll-text">Scroll to see my edits</span>
          <span class="pc-scroll-arrows" aria-hidden="true"><i></i><i></i></span>
        </a>
      </div>
    </section>

    <section class="pc-screen pc-fit pc-feat" id="featured" aria-labelledby="featured-title">
      <div class="pc-feat-copy">
        <p class="sk-no" data-reveal><b>02</b> Featured</p>
        <h2 id="featured-title" data-reveal>Featured works</h2>
        <p class="pc-feat-sub" data-reveal style="--i:1">Shorts for TikTok and YouTube, with dynamic subtitles, motion graphics, and comedic timing.</p>
      </div>
      <div class="pc-feat-visual" data-reveal>
        <FeaturedCarousel clips={featured} initialId={hero.id} />
      </div>
      <div class="pc-feat-cta">
        <a class="pc-btn pc-btn-gold pc-btn-lg" href="/works">See all works <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="pc-screen pc-fit pc-about" id="about" aria-labelledby="about-title">
      {/* PLACEHOLDER VIDEO: set site.aboutVideo.src (and .poster) in src/data/site.ts once the About video is edited. */}
      <div class="pc-photo">
        {site.aboutVideo.src ? (
          <video src={site.aboutVideo.src} poster={site.aboutVideo.poster || undefined} muted loop playsinline controls preload="metadata" aria-label="About Katou video"></video>
        ) : (
          <div class="pc-vid-ph" role="img" aria-label="Placeholder: About video coming soon">
            <span class="pc-vid-play" aria-hidden="true"><svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
            <span class="pc-vid-cap">About video coming soon</span>
            <span class="sk-rec" aria-hidden="true">Rec</span><span class="sk-tc" aria-hidden="true">00:00:00:00</span>
          </div>
        )}
      </div>
      <div class="pc-about-copy">
        <p class="sk-no"><b>03</b> Profile</p>
        <h2 id="about-title">About Katou</h2>
        <p>{site.description}</p>
        <dl class="sk-stats">
          <div><dt>Edits</dt><dd>{clips.length}</dd></div>
          {turnaround && <div><dt>Turnaround</dt><dd>{turnaround}</dd></div>}
        </dl>
      </div>
    </section>

    <section class="pc-screen pc-contact" id="contact" aria-labelledby="contact-title">
      <span class="pc-blob pc-blob-blue" aria-hidden="true"></span>
      <span class="pc-blob pc-blob-gold2" aria-hidden="true"></span>
      <p class="sk-no"><b>04</b> Contact</p>
      <h2 id="contact-title">Let’s make <em>something.</em></h2>
      <a class="pc-btn pc-btn-gold" href="/contact">Contact</a>
    </section>
  </div>
  <ClipPreview client:idle />
  <ClipViewer client:idle clips={viewerClips.map(toViewerClip)} />
</BaseLayout>

<script>
  // Light staggered reveals. Transform and opacity only; each element animates once.
  if (document.documentElement.classList.contains('reveal-ready')) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reveal = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        reveal.unobserve(entry.target);
      }
    }, { rootMargin: '0px 0px -8% 0px', threshold: .1 });
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element) => reveal.observe(element));
    reduced.addEventListener('change', () => {
      if (!reduced.matches) return;
      document.documentElement.classList.remove('reveal-ready');
      reveal.disconnect();
    });
  }
</script>
