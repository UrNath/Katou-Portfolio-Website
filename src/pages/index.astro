---
import BaseLayout from '../components/BaseLayout.astro';
import CharacterArt from '../components/CharacterArt.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import ServiceSection from '../components/ServiceSection.astro';
import TermsSection from '../components/TermsSection.astro';
import StatusChip from '../components/StatusChip.astro';
import ClipPreview from '../islands/ClipPreview';
import ClipViewer from '../islands/ClipViewer';
import { site } from '../data/site';
import { status } from '../data/status';
import { creators } from '../data/tags';
import { heroReel, hubClips, loadClips, toViewerClip } from '../lib/clips';
import { loadService } from '../lib/services';
const clips = await loadClips();
const featured = hubClips(clips);
const { hero } = heroReel(clips);
const editing = await loadService('editing');
const web = await loadService('web-design');
const artOn = site.characterArt.enabled && Boolean(site.characterArt.src);
// The featured pool, exclusions, order and gallery data remain unchanged.
---
<BaseLayout>
  <div class="scroll-portfolio">
    <section class="intro-panel scroll-panel cinematic-hero" id="home" aria-labelledby="intro-title">
      <span class="hero-watermark" aria-hidden="true">NassuKatou</span>
      <div class:list={['intro-visual', artOn && 'has-character']}>
        {artOn ? <CharacterArt /> : (
          <div class="hero-sculpture" aria-hidden="true">
            <svg class="sculpture-echo" viewBox="0 0 600 700" fill="none"><use href="#hero-bloom" /></svg>
            <svg class="sculpture-main" viewBox="0 0 600 700" fill="none" data-parallax="0.07">
              <defs>
                <linearGradient id="wing-front" x1="100" y1="100" x2="450" y2="640" gradientUnits="userSpaceOnUse"><stop stop-color="#f3ffff"/><stop offset=".4" stop-color="#9ae8e3"/><stop offset="1" stop-color="#247f9a"/></linearGradient>
                <linearGradient id="wing-back" x1="480" y1="100" x2="180" y2="600" gradientUnits="userSpaceOnUse"><stop stop-color="#a6ebef" stop-opacity=".95"/><stop offset="1" stop-color="#4a6cbd" stop-opacity=".1"/></linearGradient>
                <radialGradient id="bloom-core"><stop stop-color="#fff"/><stop offset=".45" stop-color="#cffbfa"/><stop offset="1" stop-color="#76d9e0" stop-opacity="0"/></radialGradient>
                <g id="hero-bloom">
                  <ellipse cx="290" cy="360" rx="212" ry="270" stroke="#c5f4f0" stroke-opacity=".28" transform="rotate(-24 290 360)"/>
                  <ellipse cx="290" cy="360" rx="245" ry="184" stroke="#c5f4f0" stroke-opacity=".2" transform="rotate(-24 290 360)"/>
                  <path d="M294 406C118 338 65 171 116 68C222 105 317 223 294 406Z" fill="url(#wing-front)"/>
                  <path d="M292 406C312 229 431 105 535 123C554 258 449 382 292 406Z" fill="url(#wing-back)"/>
                  <path d="M295 403C151 366 74 438 90 568C197 587 281 524 295 403Z" fill="url(#wing-back)"/>
                  <path d="M293 405C420 387 513 454 494 615C382 587 303 517 293 405Z" fill="url(#wing-front)"/>
                  <path d="M116 68C187 210 262 319 294 406M535 123C427 217 355 316 294 406M90 568L294 406L494 615" stroke="#efffff" stroke-opacity=".55"/>
                  <ellipse cx="294" cy="406" rx="80" ry="100" fill="url(#bloom-core)"/>
                  <path d="M295 329C310 364 311 412 295 464C279 412 280 364 295 329Z" fill="#e5ffff"/>
                  <path d="M282 344Q253 299 246 275M305 345Q327 300 350 288" stroke="#e5ffff" stroke-width="2"/>
                  <circle cx="174" cy="168" r="4" fill="#e5ffff"/><circle cx="459" cy="359" r="3" fill="#e5ffff"/><circle cx="135" cy="425" r="2" fill="#e5ffff"/>
                </g>
              </defs>
              <use href="#hero-bloom" />
            </svg>
            <span class="sculpture-note">TIMING. MOTION. PERSONALITY.</span>
          </div>
        )}
      </div>
      <div class="intro-copy">
        <p class="section-label">THE PERSON BEHIND THE TIMELINE</p>
        <h1 id="intro-title">Meet the Editor!<br /><span>Katou</span></h1>
        <p class="intro-role">{site.role}</p>
        <div class="intro-actions">
          <a class="outline-button" href="#editing">Commission Info <span aria-hidden="true">↗</span></a>
          <button class="solid-button" type="button" data-open-clip={hero.id}>Play Highlight Reel <span aria-hidden="true">▶</span></button>
        </div>
        <div class="intro-status">
          <span>Editing <StatusChip status={status.editing} /></span>
          <span>Web design <StatusChip status={status.webDesign} /></span>
        </div>
      </div>
      <a class="scroll-cue" href="#featured">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a>
    </section>

    <section class="featured-panel scroll-panel" id="featured" aria-labelledby="featured-title">
      <div class="featured-visual">
        <svg class="outline-word" viewBox="0 0 900 190" aria-hidden="true" focusable="false"><text x="5" y="160" textLength="885" lengthAdjust="spacingAndGlyphs">SHORTS</text></svg>
        <FeaturedCarousel clips={featured} initialId={hero.id} />
      </div>
      <div class="featured-copy">
        <p class="section-label">FEATURED WORKS</p>
        <h2 id="featured-title">Engaging edits that keep viewers hooked.</h2>
        <p>Shorts for TikTok and YouTube, with dynamic subtitles, motion graphics, and comedic timing.</p>
        <a class="solid-button" href="/works">View Full Gallery <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="detail-panel" id="editing" aria-label="Editing commissions">
      <div class="section-marker"><span>01 / EDITING</span><span aria-hidden="true" data-parallax="0.05">✳</span></div>
      <ServiceSection service={editing} />
    </section>
    <section class="detail-panel web-panel" id="web-design" aria-label="Web design commissions">
      <div class="section-marker"><span>02 / WEB DESIGN</span><span aria-hidden="true" data-parallax="-0.05">↗</span></div>
      <ServiceSection service={web} />
    </section>
    <section class="clients-panel detail-panel" id="clients" aria-labelledby="clients-title">
      <p class="section-label">THE CREATORS BEHIND THE CLIPS</p>
      <h2 id="clients-title">Meet the Clients!</h2>
      <p class="clients-intro">Explore the edits for each creator.</p>
      <div class="client-links">
        {creators.filter((creator) => clips.some((clip) => clip.creatorId === creator.id)).map((creator, index) => (
          <a href={`/works?creator=${encodeURIComponent(creator.id)}`}>
            <span class="client-index">{String(index + 1).padStart(2, '0')}</span>
            <span>{creator.label}</span><span class="client-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <section class="detail-panel terms-panel" id="terms" aria-label="Commission terms">
      <p class="section-label">THE DETAILS, UP FRONT</p>
      <TermsSection />
    </section>
    <section class="detail-panel commission-panel" id="commission" aria-label="Commission Katou">
      <p class="section-label">YOUR NEXT PROJECT STARTS HERE</p>
      <ContactSection />
    </section>
  </div>
  <ClipPreview client:visible />
  <ClipViewer client:idle clips={featured.map(toViewerClip)} />
</BaseLayout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = window.matchMedia('(max-width: 767px)');
  const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
  let frame = 0;
  function paint() {
    frame = 0;
    for (const layer of layers) {
      if (reduced.matches || mobile.matches) {
        layer.style.removeProperty('transform');
        continue;
      }
      const section = layer.closest('section');
      if (!section) continue;
      const bounds = section.getBoundingClientRect();
      if (bounds.bottom < -100 || bounds.top > innerHeight + 100) continue;
      const offset = (innerHeight / 2 - (bounds.top + bounds.height / 2));
      const strength = Number(layer.dataset.parallax) || 0;
      layer.style.transform = `translate3d(0, ${Math.max(-64, Math.min(64, offset * strength))}px, 0)`;
    }
  }
  function schedule() { if (!frame) frame = requestAnimationFrame(paint); }
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  reduced.addEventListener('change', schedule);
  mobile.addEventListener('change', schedule);
  paint();

  // Keep section links readable and useful for keyboard and browser history navigation.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.desk-nav a[href^="/#"]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.scroll-portfolio > section[id]'));
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const id = entry.target.id === 'featured' ? 'home' : entry.target.id;
        links.forEach((link) => {
          if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
    }, { rootMargin: '-20% 0px -60% 0px', threshold: 0 });
    sections.forEach((section) => observer.observe(section));
  }
</script>
