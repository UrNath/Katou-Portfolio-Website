---
import BaseLayout from '../components/BaseLayout.astro';
import SiteIntro from '../components/SiteIntro.astro';
import CharacterArt from '../components/CharacterArt.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import ShortsWordmark from '../components/ShortsWordmark.astro';
import CommissionCta from '../components/CommissionCta.astro';
import ServiceSection from '../components/ServiceSection.astro';
import TermsSection from '../components/TermsSection.astro';
import StatusChip from '../components/StatusChip.astro';
import ClipPreview from '../islands/ClipPreview';
import ClipViewer from '../islands/ClipViewer';
import { site } from '../data/site';
import { status } from '../data/status';
import { heroReel, hubClips, loadClips, toViewerClip } from '../lib/clips';
import { loadService } from '../lib/services';
const clips = await loadClips();
const featured = hubClips(clips);
const { hero } = heroReel(clips);
const editing = await loadService('editing');
const web = await loadService('web-design');
const artOn = site.characterArt.enabled && Boolean(site.characterArt.src);
// The featured pool, exclusions, order and gallery data remain unchanged.
---
<BaseLayout>
  <SiteIntro />
  <script is:inline>
    // Reveals are opt-in: content stays visible without scripting, without
    // IntersectionObserver, and for visitors who prefer reduced motion.
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('reveal-ready');
    }
  </script>
  <div class="scroll-portfolio" data-deck>
    <section class="intro-panel scroll-panel" id="home" aria-labelledby="intro-title">
      <div class:list={['intro-visual', artOn && 'has-character']}>
        {artOn ? <CharacterArt /> : (
          /* PLACEHOLDER: typographic stand-in until Katou supplies human-drawn OC art
             (enable site.characterArt). The square frame keeps its dimensions either way. */
          <div class="type-art" data-placeholder="hero-art" aria-hidden="true">
            <span class="art-label">PLACEHOLDER / CHARACTER ART TO COME</span>
            <span class="art-orbit" data-parallax="-0.07"></span>
            <span class="art-word" data-parallax="0.09">Cut.<br /><em>Create.</em></span>
            <span class="art-star" data-parallax="-0.13">✳</span>
            <span class="art-caption">A little timing.<br />A lot of personality.</span>
          </div>
        )}
      </div>
      <div class="intro-copy">
        <p class="section-label" data-reveal>THE PERSON BEHIND THE TIMELINE</p>
        <h1 id="intro-title" data-reveal style="--i:1">Meet the Editor!<br /><span>Katou</span></h1>
        <p class="intro-role" data-reveal style="--i:2">{site.role}</p>
        <div class="intro-actions" data-reveal style="--i:3">
          <a class="solid-button" href="/works">View Works <span aria-hidden="true">↗</span></a>
          <a class="outline-button" href="#commission">Commission <span aria-hidden="true">↓</span></a>
          <button class="text-button" type="button" data-open-clip={hero.id}><span aria-hidden="true">▶</span> Play highlight reel</button>
        </div>
        <div class="intro-status" data-reveal style="--i:4">
          <span>Editing <StatusChip status={status.editing} /></span>
          <span>Web design <StatusChip status={status.webDesign} /></span>
        </div>
      </div>
      <a class="scroll-cue" href="#services">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a>
    </section>

    <section class="services-panel detail-panel" id="services" aria-labelledby="services-title" data-ghost="Services">
      <div class="time-rule" style="--at:14" aria-hidden="true"><span></span></div>
      <p class="section-label" data-reveal>WHAT I DO</p>
      <h2 id="services-title" data-reveal style="--i:1">{site.role}</h2>
      <div class="service-cards">
        {[
          { entry: editing, href: '#editing', state: status.editing, approx: undefined },
          { entry: web, href: '#web-design', state: status.webDesign, approx: web.data.fromApprox },
        ].map(({ entry, href, state, approx }, index) => (
          <a class="service-card" href={href} data-reveal style={`--i:${index + 2}`}>
            <span class="service-card-top"><span class="service-card-index">0{index + 1}</span><StatusChip status={state} /></span>
            <span class="service-card-title">{entry.data.title}</span>
            <span class="service-card-sub">{entry.data.subtitle}</span>
            <span class="service-card-foot">
              <span>From <strong>{entry.data.fromPrice}</strong>{approx && <small> {approx}</small>}</span>
              <span class="service-card-arrow" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="featured-panel scroll-panel" id="featured" aria-labelledby="featured-title" data-ghost="Featured">
      <div class="time-rule" style="--at:36" aria-hidden="true"><span></span></div>
      <div class="featured-visual" data-reveal>
        <ShortsWordmark />
        <FeaturedCarousel clips={featured} initialId={hero.id} />
      </div>
      <div class="featured-copy">
        <p class="section-label" data-reveal>FEATURED WORKS</p>
        <h2 id="featured-title" data-reveal style="--i:1">Engaging edits that keep viewers hooked.</h2>
        <p data-reveal style="--i:2">Shorts for TikTok and YouTube, with dynamic subtitles, motion graphics, and comedic timing.</p>
        <div class="intro-actions" data-reveal style="--i:3">
          <a class="solid-button" href="/works">View Full Gallery <span aria-hidden="true">↗</span></a>
          <a class="outline-button" href="#commission">Commission <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <section class="detail-panel" id="editing" aria-label="Editing commissions" data-ghost="Editing">
      <div class="time-rule" style="--at:54" aria-hidden="true"><span></span></div>
      <div class="section-marker"><span>01 / EDITING</span><span aria-hidden="true" data-parallax="0.05">✳</span></div>
      <ServiceSection service={editing} />
    </section>
    <section class="detail-panel web-panel" id="web-design" aria-label="Web design commissions" data-ghost="Web">
      <div class="time-rule" style="--at:70" aria-hidden="true"><span></span></div>
      <div class="section-marker"><span>02 / WEB DESIGN</span><span aria-hidden="true" data-parallax="-0.05">↗</span></div>
      <ServiceSection service={web} />
    </section>
    <section class="detail-panel terms-panel" id="terms" aria-label="Commission terms" data-ghost="Terms">
      <div class="time-rule" style="--at:84" aria-hidden="true"><span></span></div>
      <p class="section-label">THE DETAILS, UP FRONT</p>
      <TermsSection />
    </section>
    <section class="detail-panel commission-panel" id="commission" aria-label="Commission Katou" data-ghost="Commission" data-footer-slot>
      <div class="time-rule" style="--at:97" aria-hidden="true"><span></span></div>
      <p class="section-label">YOUR NEXT PROJECT STARTS HERE</p>
      <CommissionCta />
    </section>
    <!-- Phone deck chrome (hidden on wider screens): transition band, scroll cue, tab bar. -->
    <div class="deck-wipe" aria-hidden="true"></div>
    <p class="deck-cue" aria-hidden="true">More <span>▾</span></p>
    <nav class="deck-tabs" aria-label="Home sections">
      {[
        ['home', 'Home'], ['services', 'Services'], ['featured', 'Featured'], ['editing', 'Editing'],
        ['web-design', 'Web'], ['terms', 'Terms'], ['commission', 'Commission'],
      ].map(([id, label]) => <a href={`#${id}`} data-deck-tab={id}>{label}</a>)}
    </nav>
  </div>
  <ClipPreview client:idle />
  <ClipViewer client:idle clips={featured.map(toViewerClip)} />
</BaseLayout>

<script>
  import { mountHomeScroll } from '../lib/home-scroll';
  import { mountDeck } from '../lib/screen-deck';
  mountHomeScroll();
  mountDeck();
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = window.matchMedia('(max-width: 767px)');
  const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
  let frame = 0;
  function paint() {
    frame = 0;
    for (const layer of layers) {
      if (reduced.matches || mobile.matches) {
        layer.style.removeProperty('transform');
        continue;
      }
      const section = layer.closest('section');
      if (!section) continue;
      const bounds = section.getBoundingClientRect();
      if (bounds.bottom < -100 || bounds.top > innerHeight + 100) continue;
      const offset = (innerHeight / 2 - (bounds.top + bounds.height / 2));
      const strength = Number(layer.dataset.parallax) || 0;
      layer.style.transform = `translate3d(0, ${Math.max(-64, Math.min(64, offset * strength))}px, 0)`;
    }
  }
  function schedule() { if (!frame) frame = requestAnimationFrame(paint); }
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  reduced.addEventListener('change', schedule);
  mobile.addEventListener('change', schedule);
  paint();

  // Light staggered reveals, and a playhead that advances along each section's
  // timeline rule. Transform and opacity only; each element animates once.
  const revealed = document.querySelectorAll<HTMLElement>('[data-reveal], .time-rule');
  if (document.documentElement.classList.contains('reveal-ready')) {
    const reveal = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        reveal.unobserve(entry.target);
      }
    }, { rootMargin: '0px 0px -8% 0px', threshold: .1 });
    revealed.forEach((element) => reveal.observe(element));
    reduced.addEventListener('change', () => {
      if (!reduced.matches) return;
      document.documentElement.classList.remove('reveal-ready');
      reveal.disconnect();
    });
  }

  // Keep section links readable and useful for keyboard and browser history navigation.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.desk-nav a[href^="/#"]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.scroll-portfolio > section[id]'));
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const id = entry.target.id === 'featured' ? 'home' : entry.target.id;
        links.forEach((link) => {
          if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
    }, { rootMargin: '-20% 0px -60% 0px', threshold: 0 });
    sections.forEach((section) => observer.observe(section));
  }
</script>
