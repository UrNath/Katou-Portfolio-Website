---
import BaseLayout from '../components/BaseLayout.astro';
import ClientGallery from '../components/ClientGallery.astro';
import { creators } from '../data/tags';
import { loadClips } from '../lib/clips';

const clips = await loadClips();
const clients = creators.filter((creator) => clips.some((clip) => clip.creatorId === creator.id));
---
<BaseLayout title="Meet the Clients">
  <section class="clients-page" aria-labelledby="clients-title">
    <p class="section-label">THE CREATORS BEHIND THE CLIPS</p>
    <h1 id="clients-title">Meet the Clients!</h1>
    <ClientGallery creators={clients} />
  </section>
</BaseLayout>

<style>
  .clients-page { width: min(94%, 92rem); margin: 2rem auto 4rem; }
  h1 { font-size: clamp(2rem, 5vw, 4rem); line-height: 1.05; margin-block: .25rem .75rem; }
</style>
