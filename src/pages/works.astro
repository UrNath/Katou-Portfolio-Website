---
import BaseLayout from '../components/BaseLayout.astro';
import ClipCard from '../components/ClipCard.astro';
import ClipPreview from '../islands/ClipPreview';
import ClipViewer from '../islands/ClipViewer';
import ThumbnailViewer from '../islands/ThumbnailViewer';
import WorksFilters from '../islands/WorksFilters';
import { clipTags, creators, filterBoot, filterCss } from '../data/tags';
import { loadClips, toViewerClip } from '../lib/clips';
import { clipsInSection, creatorIdOf, loadThumbnails, longFormCategories, workSections } from '../lib/works-layout';

const clips = await loadClips();
const thumbnails = loadThumbnails(clips);
const blocks = workSections
  .map((section) => {
    if (section.kind === 'thumbnail') {
      return { section, clips: [], thumbs: thumbnails };
    }
    return { section, clips: clipsInSection(section, clips), thumbs: [] };
  })
  .filter((block) => block.clips.length > 0 || block.thumbs.length > 0);
const editLabel = `${clips.length} video edits · ${thumbnails.length} thumbnails`;
const names = creators.map((creator) => creator.label).join(', ');
const sectionNames = blocks.map((block) => block.section.label).join(', ');
const cardSizes = '(min-width: 1280px) 220px, (min-width: 1024px) 22vw, (min-width: 768px) 30vw, 46vw';
const wideSizes = '(min-width: 768px) 46vw, 100vw';
---

<BaseLayout
  title="Works"
  description={`${editLabel} for ${names}. ${sectionNames}, with content type, creator, and tag filters.`}
>
  <style slot="head" is:inline set:html={filterCss()} />
  <script slot="head" is:inline set:html={filterBoot()} />
  <section class="works">
    <header class="works-head">
      <h1 class="page-title reveal">Works</h1>
      <p class="clip-count" data-clip-count aria-live="polite">{editLabel}</p>
    </header>
    <form class="works-search" role="search">
      <label>
        <span class="sr-only">Search edits</span>
        <input id="works-search" type="search" name="q" placeholder="Search titles or clients" autocomplete="off" enterkeyhint="search" />
      </label>
    </form>
    <div class="works-filter-groups" aria-label="Filter works">
      <div class="works-filter-row">
        <span class="works-filter-label" id="filter-type-heading">Content</span>
        <div class="filters" role="group" aria-labelledby="filter-type-heading">
          <button class="filter-chip" type="button" data-filter-kind="type" data-filter-value="" aria-pressed="true">All types</button>
          <button class="filter-chip" type="button" data-filter-kind="type" data-filter-value="short" aria-pressed="false">Short Form</button>
          <button class="filter-chip" type="button" data-filter-kind="type" data-filter-value="long" aria-pressed="false">Long Form</button>
          <button class="filter-chip" type="button" data-filter-kind="type" data-filter-value="thumbnail" aria-pressed="false">Thumbnails</button>
        </div>
      </div>
      <div class="works-filter-row">
        <span class="works-filter-label" id="filter-creator-heading">VTuber</span>
        <div class="filters" role="group" aria-labelledby="filter-creator-heading">
          <button class="filter-chip" type="button" data-filter-kind="creator" data-filter-value="" aria-pressed="true">All creators</button>
          {
            creators.map((creator) => (
              <button class="filter-chip" type="button" data-filter-kind="creator" data-filter-value={creator.id} aria-pressed="false">
                {creator.label}
              </button>
            ))
          }
        </div>
      </div>
      {
        clipTags.length > 0 && (
          <div class="works-filter-row">
            <span class="works-filter-label" id="filter-tags-heading">Tags</span>
            <div class="filters" role="group" aria-labelledby="filter-tags-heading">
              <button class="filter-chip" type="button" data-filter-kind="tag" data-filter-value="" aria-pressed="true">All tags</button>
              {clipTags.map((tag) => (
                <button class="filter-chip" type="button" data-filter-kind="tag" data-filter-value={tag.id} aria-pressed="false">
                  {tag.label}
                </button>
              ))}
            </div>
          </div>
        )
      }
    </div>
    <WorksFilters client:visible />
    <ClipPreview client:visible />
    {
      blocks.map((block) => (
        <div class="works-block" data-block={block.section.id} data-section-kind={block.section.kind}>
          <h2 class="works-kicker">{block.section.label}</h2>
          {block.section.kind === 'thumbnail' && (
            <p class="works-thumbnails-note">A gallery of thumbnails used for these videos. Design credit may vary.</p>
          )}
          {
            block.section.kind === 'thumbnail' ? (
              <div class="works-grid works-grid-wide thumb-grid">
                {block.thumbs.map((thumb) => (
                  <article
                    class:list={['clip-card', 'thumb-card', thumb.orientation === 'vertical' && 'is-portrait']}
                    data-creator={creatorIdOf(thumb.creator)}
                    data-content-type="thumbnail"
                    data-tags=""
                    data-find={`${thumb.title} ${thumb.creator} ${thumb.channelHandle}`}
                  >
                    <button
                      class="thumb-open"
                      type="button"
                      data-open-thumb={thumb.id}
                      aria-label={`View thumbnail for ${thumb.title}, ${thumb.creator}`}
                    >
                      <span class:list={['clip-frame', thumb.orientation !== 'vertical' && 'is-wide']}>
                        <img src={thumb.image} alt="" loading="lazy" decoding="async" />
                      </span>
                    </button>
                  </article>
                ))}
              </div>
            ) : block.section.kind === 'landscape' ? (
              <div class="works-long-form">
                {longFormCategories.map((category) => {
                  const group = block.clips.filter((clip) => clip.longFormCategory === category.id);
                  if (group.length === 0) return null;
                  return (
                    <section class="works-subgroup" data-long-form-category={category.id}>
                      <h3 class="works-subtitle">{category.label}</h3>
                      <div class="works-grid works-grid-wide">
                        {group.map((clip) => <ClipCard clip={clip} sizes={wideSizes} />)}
                      </div>
                    </section>
                  );
                })}
              </div>
            ) : (
              <div class="works-grid">
                {block.clips.map((clip, index) => (
                  <ClipCard
                    clip={clip}
                    sizes={cardSizes}
                    eager={index < 2 && block.section.kind === 'vertical'}
                    priority={index === 0 && block.section.kind === 'vertical'}
                  />
                ))}
              </div>
            )
          }
        </div>
      ))
    }
    <p class="works-empty" data-empty hidden>No edits match.</p>
    <ClipViewer client:idle clips={clips.map(toViewerClip)} />
    <ThumbnailViewer client:idle items={thumbnails} />
  </section>
  <script is:inline>
    (function () {
      var input = document.getElementById('works-search');
      if (input) input.value = new URLSearchParams(location.search).get('q') || '';

      function words(value) {
        return value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      }

      function hit(card, query) {
        if (!query.length) return true;
        var hay = (card.getAttribute('data-find') || '').toLowerCase();
        return query.every(function (word) { return hay.indexOf(word) !== -1; });
      }

      function sync() {
        var query = words(input ? input.value : '');
        document.querySelectorAll('.clip-card').forEach(function (card) {
          card.style.display = hit(card, query) ? '' : 'none';
        });
        document.querySelectorAll('.works-subgroup').forEach(function (group) {
          var hasVisible = Array.from(group.querySelectorAll('.clip-card')).some(function (card) {
            return getComputedStyle(card).display !== 'none';
          });
          group.hidden = !hasVisible;
        });
        document.querySelectorAll('.works-block').forEach(function (block) {
          var any = false;
          block.querySelectorAll('.clip-card').forEach(function (card) {
            if (getComputedStyle(card).display !== 'none') any = true;
          });
          block.style.display = any ? '' : 'none';
        });
        var shown = 0;
        document.querySelectorAll('.clip-card').forEach(function (card) {
          if (getComputedStyle(card).display !== 'none') shown += 1;
        });
        var count = document.querySelector('[data-clip-count]');
        if (count) count.textContent = shown + (shown === 1 ? ' work shown' : ' works shown');
        var empty = document.querySelector('[data-empty]');
        if (empty) {
          empty.hidden = shown !== 0;
          empty.textContent = query.length
            ? 'No works match that search and filter combination.'
            : 'No works match these filters.';
        }
      }

      window.__nkWorksSync = sync;
      if (input) {
        input.form.addEventListener('submit', function (event) { event.preventDefault(); });
        input.addEventListener('input', function () {
          var params = new URLSearchParams(location.search);
          var text = input.value.trim();
          if (text) params.set('q', text);
          else params.delete('q');
          var next = params.toString();
          history.replaceState(null, '', next ? '/works?' + next : '/works');
          sync();
        });
      }
      window.addEventListener('popstate', function () {
        if (input) {
          var text = new URLSearchParams(location.search).get('q') || '';
          if (input.value !== text) input.value = text;
        }
        sync();
      });
      sync();
    })();
  </script>
</BaseLayout>
