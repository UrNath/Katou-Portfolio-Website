---
import BaseLayout from '../components/BaseLayout.astro';
import ClipCard from '../components/ClipCard.astro';
import ClipPreview from '../islands/ClipPreview';
import ClipViewer from '../islands/ClipViewer';
import ThumbnailViewer from '../islands/ThumbnailViewer';
import WorksFilters from '../islands/WorksFilters';
import { clipTags, creators, filterBoot, filterCss } from '../data/tags';
import { loadClips, toViewerClip } from '../lib/clips';
import { clipsInSection, creatorIdOf, loadThumbnails, workSections } from '../lib/works-layout';

const clips = await loadClips();
const thumbnails = loadThumbnails();
const blocks = workSections
  .map((section) => {
    if (section.kind === 'thumbnail') {
      return { section, clips: [], thumbs: thumbnails };
    }
    return { section, clips: clipsInSection(section, clips), thumbs: [] };
  })
  .filter((block) => block.clips.length > 0 || block.thumbs.length > 0);
const total = clips.length + thumbnails.length;
const editLabel = `${total} ${total === 1 ? 'edit' : 'edits'}`;
const names = creators.map((creator) => creator.label).join(', ');
const sectionNames = blocks.map((block) => block.section.label).join(', ');
const cardSizes = '(min-width: 1280px) 220px, (min-width: 1024px) 22vw, (min-width: 768px) 30vw, 46vw';
const wideSizes = '(min-width: 768px) 46vw, 100vw';
---

<BaseLayout
  title="Works"
  description={`${editLabel} for ${names}. ${sectionNames}, with creator and tag filters.`}
>
  <style slot="head" is:inline set:html={filterCss()} />
  <script slot="head" is:inline set:html={filterBoot()} />
  <section class="works">
    <header class="works-head">
      <h1 class="page-title reveal">Works</h1>
      <p class="clip-count" data-clip-count aria-live="polite">{editLabel}</p>
    </header>
    <div class="filters" role="toolbar" aria-label="Filter edits by creator or tag">
      <button class="filter-chip" type="button" data-filter="" aria-pressed="true">All</button>
      {
        creators.map((creator) => (
          <button class="filter-chip" type="button" data-filter={`creator:${creator.id}`} aria-pressed="false">
            {creator.label}
          </button>
        ))
      }
      {
        clipTags.length > 0 && (
          <>
            <span class="filter-gap" aria-hidden="true"></span>
            {clipTags.map((tag) => (
              <button class="filter-chip" type="button" data-filter={tag.id} aria-pressed="false">
                {tag.label}
              </button>
            ))}
          </>
        )
      }
    </div>
    <WorksFilters client:visible />
    <ClipPreview client:visible />
    {
      blocks.map((block) => (
        <div class="works-block" data-block={block.section.id}>
          <h2 class="works-kicker">{block.section.label}</h2>
          {
            block.section.kind === 'thumbnail' ? (
              <div class="works-grid works-grid-wide thumb-grid">
                {block.thumbs.map((thumb) => (
                  <article class="clip-card thumb-card" data-creator={creatorIdOf(thumb.creator)} data-tags="">
                    <button class="thumb-open" type="button" data-open-thumb={thumb.id}>
                      <span class="clip-frame is-wide">
                        <img src={thumb.image} alt="" />
                        <span class="clip-meta">
                          <span class="clip-title">{thumb.title}</span>
                          <span class="clip-credit">{thumb.creator}</span>
                        </span>
                      </span>
                    </button>
                  </article>
                ))}
              </div>
            ) : (
              <div class:list={['works-grid', block.section.kind === 'landscape' && 'works-grid-wide']}>
                {block.clips.map((clip, index) => (
                  <ClipCard
                    clip={clip}
                    sizes={block.section.kind === 'landscape' ? wideSizes : cardSizes}
                    eager={index < 2 && block.section.kind === 'vertical'}
                    priority={index === 0 && block.section.kind === 'vertical'}
                  />
                ))}
              </div>
            )
          }
        </div>
      ))
    }
    <p class="works-empty" data-empty hidden>No edits for that filter.</p>
    <ClipViewer client:idle clips={clips.map(toViewerClip)} />
    <ThumbnailViewer client:idle items={thumbnails} />
  </section>
  <script is:inline>
    (function () {
      var filter = document.documentElement.getAttribute('data-filter') || '';
      document.querySelectorAll('[data-filter]').forEach(function (chip) {
        var value = chip.getAttribute('data-filter') || '';
        chip.setAttribute('aria-pressed', value === filter ? 'true' : 'false');
      });
      var shown = 0;
      document.querySelectorAll('.clip-card').forEach(function (card) {
        if (getComputedStyle(card).display !== 'none') shown += 1;
      });
      var count = document.querySelector('[data-clip-count]');
      if (count) count.textContent = shown + (shown === 1 ? ' edit' : ' edits');
      var empty = document.querySelector('[data-empty]');
      if (empty) empty.hidden = shown !== 0;
    })();
  </script>
</BaseLayout>
