---
import Site from '../layouts/Site.astro';
---
<Site page="other" title="Not found">
  <main class="page on" id="p-404">
    <section class="page-head slim dots" style="--hh: var(--hot)">
      <div class="wrap"><div class="ph-row"><div class="ph-title"><p class="kicker ui"><span class="slashes"></span><span>Error 404</span></p><h1 class="name">Lost signal</h1></div></div></div>
    </section>
    <div class="wrap" style="padding-block:40px 80px;display:grid;gap:18px;justify-items:start">
      <p style="margin:0;color:var(--mute)">That page doesn’t exist, or it moved.</p>
      <a class="btn" href="/">Back home</a>
    </div>
  </main>
</Site>
