---
import BaseLayout from '../components/BaseLayout.astro';
import PricingService from '../components/PricingService.astro';
import { loadService } from '../lib/services';
const editing = await loadService('editing');
const web = await loadService('web-design');
---
<BaseLayout title="Pricing" description="Editing and web design pricing for NassuKatou.">
  <div class="pc-page">
    <header class="pc-page-head">
      <span class="pc-blob pc-blob-peach" aria-hidden="true"></span>
      <p class="pc-eyebrow">Services</p>
      <h1>Pricing</h1>
      <nav class="pc-jump" aria-label="Jump to a service">
        <a class="pc-chip" href="#editing">{editing.data.title}</a>
        <a class="pc-chip" href="#web-design">{web.data.title}</a>
      </nav>
    </header>
    <section class="pc-page-body" id="editing" aria-label="Editing commissions">
      <PricingService service={editing} />
    </section>
    <section class="pc-page-body pc-page-alt" id="web-design" aria-label="Web design commissions">
      <PricingService service={web} />
    </section>
  </div>
</BaseLayout>
