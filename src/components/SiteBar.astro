---
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import RouteButton from './RouteButton.astro';
import Wordmark from './Wordmark.astro';
import { getRoutes } from '../data/routes';
import { isCurrent, isPlaceholder, navLinks, site, socials } from '../data/site';

interface Props {
  pathname: string;
  prices: { editing: string; web: string };
}

const { pathname, prices } = Astro.props;
const routes = getRoutes(prices);
---

<header class="site-bar">
  <a class="brand" href="/" aria-label="NassuKatou, home">
    <span class="wordmark-lockup"><Wordmark /></span>
  </a>
  <nav class="desk-nav" aria-label="Primary">
    {
      navLinks.filter((link) => link.href !== '/contact').map((link) => (
        <a
          class="bar-link"
          href={link.href}
          aria-current={isCurrent(pathname, link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="bar-right">
    {
      socials.filter((item) => item.id === 'discord' || item.id === 'youtube').map((item) => (
        <a class="dia-btn" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
          <BrandIcon name={item.id} />
        </a>
      ))
    }
    <a class="bar-contact" href="/contact" aria-current={isCurrent(pathname, '/contact') ? 'page' : undefined}><span>Contact</span></a>
  </div>
  <button
    class="menu-btn"
    type="button"
    id="menu-open"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="site-menu"
  >
    <Icon name="menu" size={22} />
  </button>
  {
    isCurrent(pathname, '/') && (
      <nav class="sub-nav" aria-label="Home sections">
        <a href="#home" data-sub="home">Intro</a>
        <a href="#featured" data-sub="featured">Featured</a>
        <a href="#about" data-sub="about">About</a>
        <a href="#contact" data-sub="contact">Contact</a>
      </nav>
    )
  }
</header>

<dialog class="sheet" id="site-menu" aria-label="Menu">
  <div class="sheet-bar" data-sheet-grab>
    <div class="sheet-handle" aria-hidden="true"></div>
    <button class="sheet-close" type="button" data-sheet-close aria-label="Close menu">
      <Icon name="x" size={20} />
    </button>
  </div>
  <nav class="sheet-routes" aria-label="Mobile">
    {routes.map((route) => <RouteButton route={route} pathname={pathname} menu />)}
  </nav>
  <div class="sheet-foot">
    <div class="social-row">
      {
        socials.map((item) => (
          <a
            class="icon-btn dia-btn"
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={
              isPlaceholder(item.href) ? `${item.label}, placeholder link` : item.label
            }
          >
            <BrandIcon name={item.id} />
          </a>
        ))
      }
    </div>
    <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</dialog>

<script>
  // Home section tabs: highlight the section on screen.
  const subLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sub-nav a'));
  if (subLinks.length && 'IntersectionObserver' in window) {
    const mark = (id: string) => subLinks.forEach((link) => link.toggleAttribute('data-on', link.dataset.sub === id));
    mark('home');
    const seen = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) mark(entry.target.id); });
    }, { rootMargin: '-45% 0px -50% 0px' });
    subLinks.forEach((link) => { const target = document.getElementById(link.dataset.sub!); if (target) seen.observe(target); });
  }

  const header = document.querySelector<HTMLElement>('.site-bar');
  if (header) {
    let previous = 0;
    const updateSize = () => {
      const height = header.getBoundingClientRect().height;
      if (Math.abs(height - previous) < .5) return;
      previous = height;
      document.documentElement.style.setProperty('--site-header-height', `${height}px`);
      window.dispatchEvent(new Event('nk-layout'));
    };
    new ResizeObserver(updateSize).observe(header);
    updateSize();
  }

  const dialog = document.getElementById('site-menu');
  const openBtn = document.getElementById('menu-open');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (dialog instanceof HTMLDialogElement && openBtn instanceof HTMLButtonElement) {
    const finishClose = () => {
      dialog.classList.remove('is-closing');
      dialog.close();
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    };

    const closeSheet = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (reduce) {
        finishClose();
        return;
      }
      dialog.classList.add('is-closing');
      const done = () => {
        dialog.removeEventListener('animationend', done);
        finishClose();
      };
      dialog.addEventListener('animationend', done);
      window.setTimeout(done, 280);
    };

    openBtn.addEventListener('click', () => {
      dialog.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeSheet();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeSheet();
    });

    dialog.querySelector('[data-sheet-close]')?.addEventListener('click', closeSheet);
    dialog.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeSheet));

    const grab = dialog.querySelector('[data-sheet-grab]');
    let startY = 0;
    let dragging = false;

    grab?.addEventListener('pointerdown', (event) => {
      if (!(event instanceof PointerEvent)) return;
      dragging = true;
      startY = event.clientY;
      dialog.style.transition = 'none';
    });

    window.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const dy = Math.max(0, event.clientY - startY);
      dialog.style.transform = `translateY(${dy}px)`;
    });

    window.addEventListener('pointerup', (event) => {
      if (!dragging) return;
      dragging = false;
      const dy = event.clientY - startY;
      dialog.style.transition = '';
      dialog.style.transform = '';
      if (dy > 72) closeSheet();
    });
  }
</script>
