---
import Icon from './Icon.astro';
import { status } from '../data/status';
import { termsSections } from '../data/terms';
---

  <article class="narrow">
    <h2 class="page-title">Before we begin.</h2>
    <p class="page-sub">How an edit or a site is commissioned, revised, and delivered.</p>
    <p class="updated" style="margin-top: 12px">Terms updated {status.termsUpdated}</p>
    <div class="terms-list">
      {
        termsSections.map((section) => (
          <details class="terms" id={`term-${section.id}`} name="terms">
            <summary>
              <h2 class="term-title">{section.title}</h2>
              <span class="chevron">
                <Icon name="chevron-down" size={18} />
              </span>
            </summary>
            <div class="terms-body">
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </article>
  <script>
    function openFromHash() {
      const id = location.hash.replace('#', '');
      if (!id) return;
      const target = document.getElementById(id);
      if (target instanceof HTMLDetailsElement) {
        target.open = true;
      }
    }
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  </script>

