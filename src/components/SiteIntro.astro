---
import Wordmark from './Wordmark.astro';
---

<div class="opening" id="site-opening" hidden aria-hidden="true">
  <Wordmark />
  <span>Editing &amp; Web Design</span>
  <span class="opening-count" data-count>00</span>
</div>
<script is:inline>
  (() => {
    const opening = document.getElementById('site-opening');
    if (!opening || location.hash || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      if (sessionStorage.getItem('nk-opening')) return;
      sessionStorage.setItem('nk-opening', '1');
    } catch { /* The intro still works when storage is unavailable. */ }
    const count = opening.querySelector('[data-count]');
    const started = performance.now();
    opening.hidden = false;
    const finish = () => { opening.hidden = true; };
    opening.addEventListener('animationend', finish, { once: true });
    document.addEventListener('keydown', finish, { once: true });
    setTimeout(finish, 1700);
    function tick(now) {
      if (opening.hidden) return;
      const progress = Math.min(100, Math.round((now - started) / 9));
      count.textContent = String(progress).padStart(2, '0');
      if (progress < 100) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();
</script>

<style>
  .opening {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    grid-template-columns: 1fr auto 4ch;
    align-content: center;
    align-items: center;
    gap: clamp(1rem, 5vw, 5rem);
    padding: clamp(1.5rem, 6vw, 7rem);
    background: #fff;
    color: #181b18;
    pointer-events: none;
    animation: opening-away 550ms 950ms cubic-bezier(.76, 0, .24, 1) both;
  }
  .opening[hidden] { display: none; }
  .opening :global(.wordmark) { font-size: clamp(2.7rem, 8vw, 8rem); }
  .opening-count { font-variant-numeric: tabular-nums; color: #0b6f73; }
  @keyframes opening-away { to { clip-path: inset(0 0 100% 0); } }
  @media (max-width: 640px) {
    .opening { grid-template-columns: 1fr auto; }
    .opening :global(.wordmark) { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .opening { display: none; } }
</style>
