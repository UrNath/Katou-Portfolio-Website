---
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import type { ClientProfile } from '../data/clients';

interface Reel { title: string; poster: string; preview: string; youtube: string }
interface Props {
  clients: { id: string; label: string; profile: ClientProfile; reels: (Reel | null)[] }[];
}
const { clients } = Astro.props;
const PLACEHOLDER = 'placeholder';
const socialOrder = ['youtube', 'discord', 'tiktok'] as const;
const socialLabel = { youtube: 'YouTube', discord: 'Discord', tiktok: 'TikTok' };
---

<section class="roster" data-roster aria-label="Meet the Clients">
  <h1 class="sr">Meet the Clients</h1>

  <nav class="roster-nav" aria-label="Choose a client">
    <button class="roster-switch" type="button" data-step="1">
      <span aria-hidden="true">⇄</span> <span class="switch-text">Switch client</span>
    </button>
    <div class="roster-names">
      {clients.map((client, index) => (
        <button type="button" data-goto={index} aria-pressed={index === 0}>{client.label}</button>
      ))}
    </div>
  </nav>

  {clients.map((client, index) => {
    const { profile } = client;
    const chips = [
      { name: 'Type', value: profile.type },
      { name: 'Class', value: profile.role },
      { name: 'Element', value: profile.element },
    ];
    return (
      <article class="client" data-client={client.id} hidden={index !== 0} aria-label={client.label}
        style={`--panel:${profile.palette.panel};--deep:${profile.palette.deep};--accent:${profile.palette.accent};--rim:${profile.palette.rim}`}>
        <div class="stage" aria-hidden="true">
          <div class="stage-bg art-depth">
            {profile.skins.filter((skin) => skin.background).map((skin) => (
              <img class="bg-paint" data-skin-bg={skin.id} src={skin.background} alt="" loading="lazy" decoding="async" />
            ))}
            <span class="bg-band">{`${client.label} `.repeat(6)}</span>
          </div>
          {profile.skins.map((skin, skinIndex) => (
            <div class:list={['char', skin.art?.framed && 'is-framed']} data-skin={skin.id} hidden={skinIndex !== 0}
              style={skin.art ? `--h:${skin.art.height_pct}%;--b:${skin.art.bottom_pct}%;--r:${skin.art.right_pct}%;--ratio:${skin.art.framed ? '4/3' : `${skin.art.width}/${skin.art.height}`};--focus:${skin.art.focus ?? '50% 50%'}` : undefined}>
              <div class="char-move character-depth">
                {skin.art ? (
                  <>
                    <span class="char-echo" style={`--art:url(${skin.art.src})`}></span>
                    <img class="char-art" src={skin.art.src} width={skin.art.width} height={skin.art.height} alt=""
                      loading={index === 0 && skinIndex === 0 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                  </>
                ) : (
                  /* PLACEHOLDER: no character art has been supplied for this client yet. */
                  <div class="art-placeholder" data-placeholder="client-art">
                    <span>Character art</span>
                    <strong>Placeholder</strong>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        <div class="info">
          <h2 class="name" data-seq style="--i:0">{client.label}</h2>
          <ul class="chips" data-seq style="--i:1" aria-label="Character details">
            {chips.map((chip) => (
              <li class:list={[!chip.value && 'is-placeholder']}>
                <span>{chip.name}</span> {chip.value ?? PLACEHOLDER}
              </li>
            ))}
          </ul>
          <p class:list={['desc', !profile.description && 'is-placeholder']} data-seq style="--i:2">
            {profile.description ?? 'Description placeholder. To be supplied.'}
          </p>

          <div class="tabs" role="tablist" aria-label={`${client.label} views`} data-seq style="--i:3">
            <button type="button" role="tab" id={`tab-${client.id}-profile`} aria-controls={`panel-${client.id}-profile`} aria-selected="true"><span class="tab-wide">Highlights</span><span class="tab-narrow">Info</span></button>
            <button type="button" role="tab" id={`tab-${client.id}-skins`} aria-controls={`panel-${client.id}-skins`} aria-selected="false" tabindex="-1">Skins</button>
            <button class="tab-socials" type="button" role="tab" id={`tab-${client.id}-socials`} aria-controls={`panel-${client.id}-socials`} aria-selected="false" tabindex="-1">Socials</button>
          </div>

          <div class="panel" role="tabpanel" id={`panel-${client.id}-profile`} aria-labelledby={`tab-${client.id}-profile`}>
            <ul class="gems">
              {client.reels.map((reel, reelIndex) => (
                <li style={`--n:${reelIndex}`}>
                  <button class:list={['gem', !reel && 'is-placeholder']} type="button"
                    data-title={reel?.title} data-youtube={reel?.youtube} data-preview={reel?.preview} data-poster={reel?.poster}
                    aria-label={reel ? `Highlight reel ${reelIndex + 1}: ${reel.title}` : `Highlight reel ${reelIndex + 1}: placeholder`}>
                    <span class="gem-face">
                      {reel && (
                        <span class="gem-media">
                          <img src={reel.poster} alt="" loading="lazy" decoding="async" width="108" height="108" />
                          <video muted loop playsinline preload="none" data-src={reel.preview} width="108" height="108" tabindex="-1"></video>
                        </span>
                      )}
                      <span class="gem-icon">{reel ? <Icon name="play" size={18} /> : '?'}</span>
                    </span>
                    <span class="gem-label">{reel ? `Reel 0${reelIndex + 1}` : 'Placeholder'}</span>
                  </button>
                </li>
              ))}
            </ul>
            <p class:list={['strip', !profile.weapon && 'is-placeholder']} data-seq style="--i:5">
              <span>Main weapon</span> {profile.weapon ?? PLACEHOLDER}
            </p>
          </div>

          <div class="panel" role="tabpanel" id={`panel-${client.id}-skins`} aria-labelledby={`tab-${client.id}-skins`} hidden>
            <ul class="skins">
              {profile.skins.map((skin, skinIndex) => (
                <li>
                  <button type="button" data-skin-pick={skin.id} aria-pressed={skinIndex === 0}>
                    <span class="skin-thumb">
                      {skin.art
                        ? <img src={skin.art.src} alt="" loading="lazy" decoding="async" width="72" height="72" />
                        : <span aria-hidden="true">?</span>}
                    </span>
                    <span class="skin-text"><strong>{skin.label}</strong><small>{skin.note}</small></span>
                  </button>
                </li>
              ))}
            </ul>
            {profile.skins.length < 2 && <p class="strip is-placeholder">No other skins yet.</p>}
          </div>

          <!-- Phones show the links in their own tab; wider screens keep the row below. -->
          <div class="panel panel-socials" role="tabpanel" id={`panel-${client.id}-socials`} aria-labelledby={`tab-${client.id}-socials`} hidden>
            <ul class="social-list">
              {socialOrder.map((key) => (
                <li>
                  {profile.socials[key] ? (
                    <a href={profile.socials[key]} target="_blank" rel="noopener noreferrer">
                      <BrandIcon name={key} size={20} /> <span>{socialLabel[key]}</span> <span class="social-go" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="is-placeholder"><BrandIcon name={key} size={20} /> <span>{socialLabel[key]}</span> <span class="social-go">{PLACEHOLDER}</span></span>
                  )}
                </li>
              ))}
            </ul>
          </div>

          <ul class="socials" data-seq style="--i:6" aria-label={`${client.label} links`}>
            {socialOrder.map((key) => (
              <li>
                {profile.socials[key] ? (
                  <a href={profile.socials[key]} target="_blank" rel="noopener noreferrer">
                    <BrandIcon name={key} size={16} /> <span class="social-name">{socialLabel[key]}</span>
                  </a>
                ) : (
                  <span class="is-placeholder"><BrandIcon name={key} size={16} /> {socialLabel[key]} {PLACEHOLDER}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </article>
    );
  })}

  <div class="wipe" aria-hidden="true"></div>
  <output class="sr" aria-live="polite"></output>

  <dialog class="reel-dialog" aria-labelledby="reel-title">
    <div class="reel-card">
      <button class="reel-close" type="button" data-reel-close aria-label="Close highlight reel"><Icon name="x" size={20} /></button>
      <div class="reel-frame">
        <video muted loop playsinline preload="none" width="540" height="960"></video>
        <div class="reel-empty" hidden><span>Highlight reel</span><strong>Placeholder</strong></div>
      </div>
      <p class="reel-title" id="reel-title"></p>
      <a class="reel-link" target="_blank" rel="noopener noreferrer" hidden>Watch the full video <span aria-hidden="true">↗</span></a>
    </div>
  </dialog>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-roster]');
  if (root) {
    const stage = root;
    const clients = Array.from(stage.querySelectorAll<HTMLElement>('.client'));
    const picks = Array.from(stage.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    const status = stage.querySelector('output')!;
    const wipe = stage.querySelector<HTMLElement>('.wipe')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const posterOnly = () => document.documentElement.classList.contains('poster-only');
    // Timing and gesture tuning (documented in docs/FEATURES.md).
    const SWITCH = { leave: 340, enter: 900, reducedLeave: 160, reducedEnter: 200 };
    const SWIPE = { start: 10, travel: .8, distance: .3, velocity: .45 };
    let current = 0;
    let busy = false;
    let pending: number | undefined;

    function paint(index = current) {
      const active = clients[index];
      document.body.style.setProperty('--scene-panel', active.style.getPropertyValue('--deep'));
      document.body.style.setProperty('--scene-accent', active.style.getPropertyValue('--accent'));
      picks.forEach((pick, position) => pick.setAttribute('aria-pressed', String(position === index)));
      status.textContent = active.getAttribute('aria-label') ?? '';
    }
    paint();

    // ---- Client switch: info leaves, a slanted band crosses the stage, and the
    // next client arrives behind it with its diamonds dealt back in order. ----
    function go(index: number) {
      const target = (index + clients.length) % clients.length;
      if (target === current) return;
      if (scrub) return;
      if (busy) { pending = target; return; }
      busy = true;
      const from = clients[current];
      const to = clients[target];
      const forward = target > current !== (Math.abs(target - current) === clients.length - 1 && clients.length > 2);
      stage.dataset.dir = forward ? 'next' : 'prev';
      disarm();
      if (from.contains(document.activeElement)) picks[target]?.focus({ preventScroll: true });
      const simple = reduced.matches;
      const leave = simple ? SWITCH.reducedLeave : SWITCH.leave;
      const enter = simple ? SWITCH.reducedEnter : SWITCH.enter;
      from.classList.add('is-leaving');
      if (!simple) {
        wipe.style.setProperty('--wipe', to.style.getPropertyValue('--accent'));
        wipe.classList.remove('is-running');
        void wipe.offsetWidth;
        wipe.classList.add('is-running');
      }
      setTimeout(() => {
        from.hidden = true;
        from.classList.remove('is-leaving');
        to.hidden = false;
        to.classList.add('is-entering');
        current = target;
        paint();
        setTimeout(() => {
          to.classList.remove('is-entering');
          wipe.classList.remove('is-running');
          busy = false;
          if (pending !== undefined && pending !== current) {
            const next = pending;
            pending = undefined;
            go(next);
          } else pending = undefined;
        }, enter);
      }, leave);
    }
    stage.querySelector('[data-step]')?.addEventListener('click', () => go((pending ?? current) + 1));
    picks.forEach((pick, index) => pick.addEventListener('click', () => go(index)));

    document.addEventListener('keydown', (event) => {
      const step = { ArrowLeft: -1, ArrowRight: 1 }[event.key];
      const target = event.target as HTMLElement | null;
      if (!step || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      if (target?.closest('input, textarea, select, [contenteditable], dialog, [role="tablist"], [role="menu"], video')) return;
      event.preventDefault();
      go((pending ?? current) + step);
    });

    // ---- Touch swipe: the finger scrubs the same switch animation the button
    // plays. Dragging moves the timeline forward (old client leaves, band
    // crosses, new client arrives); dragging back rewinds it. Release finishes
    // it past a distance or speed threshold, otherwise it plays backwards. ----
    const TOTAL = SWITCH.leave + SWITCH.enter;
    let drag: { id: number; x: number; y: number; lastX: number; time: number; velocity: number; locked: boolean } | undefined;
    let scrub: { side: number; target: number; from: HTMLElement; to: HTMLElement; entering: boolean; time: number; parts: Animation[]; band: Animation[] } | undefined;
    let swiped = false;
    function hold() {
      if (!scrub) return;
      scrub.parts = (scrub.entering ? scrub.to : scrub.from).getAnimations({ subtree: true });
      scrub.band = wipe.getAnimations();
      [...scrub.parts, ...scrub.band].forEach((animation) => animation.pause());
    }
    function scrubStart(side: number) {
      const target = (current + side + clients.length) % clients.length;
      stage.dataset.dir = side > 0 ? 'next' : 'prev';
      stage.classList.add('is-scrubbing');
      wipe.style.setProperty('--wipe', clients[target].style.getPropertyValue('--accent'));
      wipe.classList.remove('is-running');
      void wipe.offsetWidth;
      wipe.classList.add('is-running');
      clients[current].classList.add('is-leaving');
      scrub = { side, target, from: clients[current], to: clients[target], entering: false, time: 0, parts: [], band: [] };
      hold();
    }
    function scrubTo(time: number) {
      if (!scrub) return;
      const entering = time >= SWITCH.leave;
      if (entering !== scrub.entering) {
        // Crossing the midpoint swaps which client is on stage, exactly as the button does.
        scrub.entering = entering;
        scrub.from.hidden = entering;
        scrub.from.classList.toggle('is-leaving', !entering);
        scrub.to.hidden = !entering;
        scrub.to.classList.toggle('is-entering', entering);
        paint(entering ? scrub.target : current);
        hold();
      }
      const local = entering ? time - SWITCH.leave : time;
      scrub.parts.forEach((animation) => { animation.currentTime = local; });
      scrub.band.forEach((animation) => { animation.currentTime = time; });
      scrub.time = time;
    }
    function scrubEnd(commit: boolean) {
      if (!scrub) return;
      const done = scrub;
      scrub = undefined;
      done.from.classList.remove('is-leaving');
      done.to.classList.remove('is-entering');
      done.from.hidden = commit;
      done.to.hidden = !commit;
      wipe.classList.remove('is-running');
      stage.classList.remove('is-scrubbing');
      if (commit) current = done.target;
      paint();
      busy = false;
    }
    function scrubFinish(commit: boolean) {
      if (!scrub) return;
      busy = true;
      const start = scrub.time;
      const end = commit ? TOTAL : 0;
      // Forward runs at the button's own speed; a cancelled swipe rewinds faster.
      const duration = Math.max(120, Math.abs(end - start) / (commit ? 1 : 1.8));
      const began = performance.now();
      const step = (now: number) => {
        if (!scrub) return;
        const amount = Math.min(1, (now - began) / duration);
        scrubTo(start + (end - start) * amount);
        if (amount < 1) requestAnimationFrame(step);
        else scrubEnd(commit);
      };
      requestAnimationFrame(step);
    }
    stage.addEventListener('pointerdown', (event) => {
      swiped = false;
      if (event.pointerType !== 'touch' || !event.isPrimary || busy || scrub || clients.length < 2) return;
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, lastX: event.clientX, time: event.timeStamp, velocity: 0, locked: false };
    });
    stage.addEventListener('pointermove', (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (!drag.locked) {
        // Below the threshold this is still a tap; a mostly vertical move is not a swipe.
        if (Math.abs(dy) > SWIPE.start && Math.abs(dy) >= Math.abs(dx)) { drag = undefined; return; }
        if (Math.abs(dx) < SWIPE.start) return;
        drag.locked = true;
        swiped = true;
        disarm();
        stage.setPointerCapture(event.pointerId);
      }
      drag.velocity = (event.clientX - drag.lastX) / Math.max(1, event.timeStamp - drag.time);
      drag.lastX = event.clientX;
      drag.time = event.timeStamp;
      if (reduced.matches) return;
      const side = dx < 0 ? 1 : -1;
      if (scrub && scrub.side !== side) { scrubTo(0); scrubEnd(false); }
      if (!scrub) scrubStart(side);
      scrubTo(Math.min(1, Math.abs(dx) / (stage.clientWidth * SWIPE.travel)) * TOTAL);
    });
    function endDrag(event: PointerEvent) {
      if (!drag || drag.id !== event.pointerId) return;
      const gesture = drag;
      drag = undefined;
      if (!gesture.locked) return;
      const dx = gesture.lastX - gesture.x;
      const side = dx < 0 ? 1 : -1;
      const speed = event.timeStamp - gesture.time < 100 ? gesture.velocity * -side : 0;
      const amount = Math.abs(dx) / (stage.clientWidth * SWIPE.travel);
      const commit = event.type === 'pointerup' && speed > -SWIPE.velocity &&
        (amount >= SWIPE.distance || (Math.abs(dx) >= 24 && speed > SWIPE.velocity));
      // Reduced motion: nothing tracked the finger, so a committed swipe uses the plain fade.
      if (reduced.matches) { if (commit) go(current + side); return; }
      scrubFinish(commit);
    }
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);
    // A finished swipe must not also count as a tap on whatever it started on.
    stage.addEventListener('click', (event) => {
      if (!swiped) return;
      swiped = false;
      event.preventDefault();
      event.stopPropagation();
    }, true);

    // ---- Tabs and skins ----
    stage.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((list) => {
      const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const select = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((other) => {
          const on = other === tab;
          other.setAttribute('aria-selected', String(on));
          other.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(other.getAttribute('aria-controls')!);
          if (panel) panel.hidden = !on;
        });
        disarm();
        if (focus) tab.focus();
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (event) => {
          const step = { ArrowLeft: -1, ArrowRight: 1 }[event.key];
          if (!step) return;
          event.preventDefault();
          select(tabs[(index + step + tabs.length) % tabs.length], true);
        });
      });
    });
    // The Socials tab only exists on upright screens; fall back to the first tab elsewhere.
    const upright = matchMedia('(max-aspect-ratio: 1/1)');
    upright.addEventListener('change', () => {
      if (upright.matches) return;
      stage.querySelectorAll<HTMLButtonElement>('.tab-socials[aria-selected="true"]').forEach((tab) =>
        tab.parentElement?.querySelector<HTMLButtonElement>('[role="tab"]')?.click());
    });
    stage.querySelectorAll<HTMLButtonElement>('[data-skin-pick]').forEach((button) => {
      button.addEventListener('click', () => {
        const client = button.closest<HTMLElement>('.client')!;
        const id = button.dataset.skinPick!;
        client.querySelectorAll<HTMLButtonElement>('[data-skin-pick]').forEach((other) =>
          other.setAttribute('aria-pressed', String(other === button)));
        client.querySelectorAll<HTMLElement>('.char').forEach((char) => {
          const on = char.dataset.skin === id;
          if (on && char.hidden) {
            char.classList.add('is-swapping');
            char.addEventListener('animationend', () => char.classList.remove('is-swapping'), { once: true });
          }
          char.hidden = !on;
        });
        client.querySelectorAll<HTMLElement>('[data-skin-bg]').forEach((bg) =>
          bg.toggleAttribute('data-on', bg.dataset.skinBg === id));
      });
    });

    // ---- Highlight diamonds ----
    const gems = Array.from(stage.querySelectorAll<HTMLButtonElement>('.gem'));
    function wake(gem: HTMLButtonElement) {
      if (gem.hasAttribute('data-live')) return;
      gem.setAttribute('data-live', '');
      const video = gem.querySelector('video');
      if (!video || posterOnly()) return;
      if (!video.src) video.src = video.dataset.src!;
      video.play().catch(() => {});
    }
    function rest(gem: HTMLButtonElement) {
      gem.removeAttribute('data-live');
      gem.removeAttribute('data-armed');
      gem.querySelector('video')?.pause();
    }
    function disarm(except?: HTMLButtonElement) {
      gems.forEach((gem) => { if (gem !== except) rest(gem); });
    }
    gems.forEach((gem) => {
      let touch = false;
      let wasArmed = false;
      gem.addEventListener('pointerdown', (event) => {
        touch = event.pointerType === 'touch';
        wasArmed = gem.hasAttribute('data-armed');
      });
      gem.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') wake(gem); });
      gem.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse' && document.activeElement !== gem) rest(gem); });
      gem.addEventListener('focus', () => { if (!restoring && gem.matches(':focus-visible')) wake(gem); });
      gem.addEventListener('blur', () => { if (!gem.matches(':hover')) rest(gem); });
      gem.addEventListener('click', () => {
        // On touch the first tap previews in place; the second opens the reel.
        if (touch && !wasArmed) {
          disarm(gem);
          gem.setAttribute('data-armed', '');
          wake(gem);
          touch = false;
          return;
        }
        touch = false;
        openReel(gem);
      });
    });
    document.addEventListener('pointerdown', (event) => {
      if (!(event.target as HTMLElement).closest?.('.gem')) gems.forEach((gem) => { if (gem.hasAttribute('data-armed')) rest(gem); });
    });

    // ---- Enlarged reel ----
    const dialog = stage.querySelector<HTMLDialogElement>('.reel-dialog')!;
    const card = dialog.querySelector<HTMLElement>('.reel-card')!;
    const player = dialog.querySelector('video')!;
    const empty = dialog.querySelector<HTMLElement>('.reel-empty')!;
    const title = dialog.querySelector<HTMLElement>('.reel-title')!;
    const link = dialog.querySelector<HTMLAnchorElement>('.reel-link')!;
    let opener: HTMLButtonElement | undefined;
    // Returning focus after the dialog closes must not restart a preview.
    let restoring = false;
    function openReel(gem: HTMLButtonElement) {
      opener = gem;
      const face = gem.querySelector('.gem-face')!.getBoundingClientRect();
      rest(gem);
      const has = Boolean(gem.dataset.preview);
      player.hidden = !has;
      empty.hidden = has;
      title.textContent = has ? gem.dataset.title ?? '' : 'This highlight reel has not been added yet.';
      link.hidden = !gem.dataset.youtube;
      if (gem.dataset.youtube) link.href = gem.dataset.youtube;
      if (has) {
        player.poster = gem.dataset.poster ?? '';
        player.src = gem.dataset.preview!;
        player.controls = true;
      }
      dialog.showModal();
      if (has && !posterOnly()) player.play().catch(() => {});
      if (!reduced.matches) {
        // Grow from the diamond it came from.
        const box = card.getBoundingClientRect();
        const dx = face.left + face.width / 2 - (box.left + box.width / 2);
        const dy = face.top + face.height / 2 - (box.top + box.height / 2);
        const scale = Math.max(.08, face.width / box.width);
        card.animate(
          [{ transform: `translate(${dx}px, ${dy}px) scale(${scale}) rotate(45deg)`, opacity: .2 }, { transform: 'none', opacity: 1 }],
          { duration: 460, easing: 'cubic-bezier(.2, .8, .2, 1)' },
        );
      }
    }
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target as HTMLElement).closest('[data-reel-close]')) dialog.close();
    });
    dialog.addEventListener('close', () => {
      player.pause();
      player.removeAttribute('src');
      player.load();
      restoring = true;
      opener?.focus({ preventScroll: true });
      restoring = false;
    });

    // ---- Depth: one clock and one pointer for every layer ----
    const origin = performance.now();
    let frame = 0;
    let pointerX = 0, pointerY = 0, smoothX = 0, smoothY = 0, last = origin;
