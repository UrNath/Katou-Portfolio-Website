---
interface Props { creators: { id: string; label: string }[] }
const { creators } = Astro.props;
const colors = ['#d8ece9', '#e8e4f2', '#f2e4d7'];
---

<p id="client-gallery-help" class="gallery-help">Scroll, swipe, or use the arrow keys to browse.</p>
<div class="client-reel" tabindex="0" role="region" aria-label="Client artwork" aria-describedby="client-gallery-help">
  {creators.map((creator, index) => (
    <article class="client-entry" aria-label={creator.label}>
      <div class="client-art" style={`--art-background: ${colors[index % colors.length]}`}>
        <svg viewBox="0 0 240 250" aria-hidden="true" fill="none">
          <circle cx="120" cy="112" r="84" stroke="currentColor" opacity=".35" />
          <path d="M41 220c9-38 38-59 79-59s70 21 79 59H41Z" fill="currentColor" opacity=".22" />
          <path d="M78 115c0-35 17-55 42-55s42 20 42 55-17 54-42 54-42-19-42-54Z" fill="currentColor" opacity=".35" />
          <path d="M64 111c0-47 23-71 56-71s56 24 56 71c-18-3-37-18-47-34-18 22-42 32-65 34Z" fill="currentColor" opacity=".65" />
        </svg>
        <span>OC artwork placeholder</span>
      </div>
      <div class="client-copy">
        <p class="section-label">{String(index + 1).padStart(2, '0')} / {String(creators.length).padStart(2, '0')}</p>
        <h3>{creator.label}</h3>
        <p>A short client introduction will go here alongside their character artwork.</p>
        <a class="outline-button" href={`/works?creator=${encodeURIComponent(creator.id)}`}>View edits <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  ))}
</div>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.client-reel').forEach((reel) => {
    const entries = Array.from(reel.querySelectorAll<HTMLElement>('.client-entry'));
    reel.addEventListener('keydown', (event) => {
      const step = { ArrowUp: -1, ArrowDown: 1, PageUp: -1, PageDown: 1 }[event.key];
      if (step === undefined && event.key !== 'Home' && event.key !== 'End') return;
      if (!entries.length || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      const top = reel.getBoundingClientRect().top;
      const current = entries.reduce((nearest, entry, i) =>
        Math.abs(entry.getBoundingClientRect().top - top) <
        Math.abs(entries[nearest].getBoundingClientRect().top - top) ? i : nearest, 0);
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? entries.length - 1 :
        Math.max(0, Math.min(entries.length - 1, current + (step ?? 0)));
      if (next === current) return;
      event.preventDefault();
      reel.scrollTo({
        top: reel.scrollTop + entries[next].getBoundingClientRect().top - top,
        behavior: reducedMotion.matches ? 'instant' : 'smooth',
      });
    });
  });
</script>

<style>
  .gallery-help { margin-block: .5rem 1.25rem; }
  .client-reel {
    height: clamp(24rem, 66svh, 42rem);
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    border: 1px solid #20262326;
    border-radius: 1.25rem;
    background: #fff;
    scrollbar-color: #0b6f73 #eef4f2;
  }
  .client-entry {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 4rem);
    padding: clamp(1rem, 4vw, 4rem);
    min-height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .client-art {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: .5rem;
    min-height: 15rem;
    padding: 1rem;
    border-radius: 1rem;
    background: var(--art-background);
    color: #264b49;
  }
  .client-art svg { width: min(100%, 14rem); max-height: 30svh; }
  .client-copy h3 { font-size: clamp(1.8rem, 4vw, 4rem); margin: .3rem 0; }
  .client-copy .outline-button { margin-top: 1rem; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .client-entry { view-timeline: --client-entry block; }
      .client-art svg {
        animation: art-travel linear both;
        animation-timeline: --client-entry;
      }
      @keyframes art-travel {
        0% { transform: translateY(24%) scale(.92); opacity: .3; }
        48%, 52% { transform: translateY(0) scale(1); opacity: 1; }
        100% { transform: translateY(-24%) scale(.92); opacity: .3; }
      }
    }
  }
  @media (max-width: 640px) {
    .client-reel { height: clamp(26rem, 72svh, 38rem); }
    .client-entry { grid-template-columns: 1fr; align-content: center; }
    .client-art { min-height: 10rem; }
    .client-art svg { max-height: 20svh; }
  }
  @media (prefers-reduced-motion: reduce) { .client-reel { scroll-snap-type: none; } }
</style>
