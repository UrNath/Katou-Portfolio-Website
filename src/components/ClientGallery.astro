---
interface Props { creators: { id: string; label: string }[] }
const { creators } = Astro.props;
const colors = [
  { panel: '#164c50', backdrop: '#357c80', glow: '#a3f0db', ink: '#192d46' },
  { panel: '#403052', backdrop: '#805588', glow: '#f5b4d2', ink: '#33264b' },
  { panel: '#693e35', backdrop: '#a96653', glow: '#ffdb9e', ink: '#432d46' },
];
// Profile paths come from the credited TikTok video URLs in clips.json.
const profiles: Record<string, string> = {
  pidge: 'https://www.tiktok.com/@pidgeira',
  chi: 'https://www.tiktok.com/@chiseyivt',
  miu: 'https://www.tiktok.com/@miuonivt',
};
---

<div class="client-gallery">
  <div class="client-reel" tabindex="0" role="region" aria-label="Meet the Clients" aria-describedby="gallery-input">
    <span id="gallery-input" class="gallery-sr">Browse clients with the up and down arrow keys.</span>
    {creators.map((creator, index) => {
      const palette = colors[index % colors.length];
      return (
        <article class="client-entry" aria-label={creator.label}
          style={`--panel:${palette.panel};--backdrop:${palette.backdrop};--glow:${palette.glow};--portrait-ink:${palette.ink}`}>
          <div class="art-window">
            <div class="client-art">
              <svg viewBox="0 0 800 900" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <g class="art-depth">
                <rect width="800" height="900" fill="var(--backdrop)" />
                <circle cx="430" cy="330" r="273" fill="var(--glow)" opacity=".55" />
                <path d="M-50 790 670 -40M100 950 850 80M-80 420 390 -90" stroke="var(--glow)" stroke-width="18" opacity=".28" />
                <circle cx="430" cy="330" r="300" fill="none" stroke="var(--glow)" stroke-width="2" />
                </g>
                <g class="character-depth"><g transform={[
                  'translate(35 55) scale(.9)',
                  'translate(745 135) scale(-.73 .73) rotate(-12 400 500)',
                  'translate(90 210) scale(.77) rotate(10 400 500)',
                ][index % 3]}>
                  {index === 1 && <path d="M180 775 70 575 88 440 135 415 161 468 149 561 292 711" fill="#f7cfc1" stroke="var(--portrait-ink)" stroke-width="18" />}
                  {index === 2 && <path d="M130 570Q-50 340 155 200L275 230 220 580M560 240Q780 210 760 610L610 630" fill="var(--portrait-ink)" />}
                  <path d={index === 1 ? 'M190 560c-70-210 2-422 223-422 210 0 290 220 220 422z' : 'M156 714c-37-132 1-226 15-323 19-153 91-253 242-253 154 0 230 111 230 252 0 119 69 200 23 324z'} fill="var(--portrait-ink)" />
                  <path d="M65 930c19-159 123-251 300-285l125 4c170 23 266 129 294 281z" fill="var(--portrait-ink)" />
                  <path d="m358 590-14 69 85 106 91-109-21-77z" fill="#d9968d" />
                  <path d="M245 376c20-113 96-158 181-158 108 0 172 68 173 169l-9 116c-10 83-80 149-158 149-84 0-157-62-170-143z" fill="#f7cfc1" />
                  <path d="M218 439c-20-175 53-293 205-293 123 0 225 81 217 237l-37 99-40-119-109-76 23 75-126-55-99 155z" fill="var(--portrait-ink)" />
                  <path d="m284 484 59-16 53 14m75-2 53-17 48 10" fill="none" stroke="var(--portrait-ink)" stroke-width="12" stroke-linecap="round" />
                  <ellipse cx="348" cy="489" rx="13" ry="17" fill="var(--backdrop)" />
                  <ellipse cx="521" cy="486" rx="13" ry="17" fill="var(--backdrop)" />
                  {index === 2 && <g fill="none" stroke="var(--glow)" stroke-width="9"><circle cx="348" cy="489" r="43" /><circle cx="521" cy="486" r="43" /><path d="M391 486h87" /></g>}
                  <path d="M408 563q27 24 57-3" fill="none" stroke="#a15068" stroke-width="7" stroke-linecap="round" />
                  <path d="m319 665 109 100 114-100 58 46-169 172-164-171z" fill="var(--glow)" />
                  <path d="m194 359 32-83 25 79 80 23-83 21-25 79-23-82-77-25z" fill="var(--glow)" />
                </g>
                <path d="m651 199 15-43 13 43 43 14-43 13-13 44-15-44-42-13zM111 563l11-30 9 30 31 9-31 10-9 30-11-30-29-10z" fill="var(--glow)" />
                </g>
              </svg>
            </div>
          </div>
          <div class="copy-window">
            <div class="client-copy">
              <h1>{creator.label}</h1>
              {profiles[creator.id] && <a href={profiles[creator.id]} aria-label={`${creator.label} on TikTok`}>TikTok</a>}
            </div>
          </div>
        </article>
      );
    })}
  </div>
  <div class="reel-controls" hidden>
    <output class="gallery-sr" aria-live="polite"></output>
    <div class="position-marks" aria-hidden="true">
      {creators.map(() => <span data-position></span>)}
    </div>
  </div>
</div>

<script>
  const reel = document.querySelector<HTMLElement>('.client-reel');
  const controls = document.querySelector<HTMLElement>('.reel-controls');
  const status = controls?.querySelector('output');
  const markers = Array.from(controls?.querySelectorAll('[data-position]') ?? []);
  const entries = Array.from(reel?.querySelectorAll<HTMLElement>('.client-entry') ?? []);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (reel && controls && status && entries.length > 1) {
    const stage = reel;
    const announcement = status;
    let current = 0;
    let moving = false;
    let wheelTotal = 0;
    let lastWheel = -Infinity;
    let wheelTimer: ReturnType<typeof setTimeout> | undefined;
    let drag: { id: number; x: number; y: number; lastY: number; time: number; velocity: number; locked: boolean } | undefined;
    let direction = 0;
    let progress = 0;
    let incomingIndex = current;
    stage.dataset.ready = '';
    controls.hidden = false;

    function show(index: number) {
      entries.forEach((entry, i) => {
        entry.hidden = i !== index;
        entry.inert = i !== index;
      });
      announcement.textContent = entries[index].getAttribute('aria-label') ?? '';
      markers.forEach((marker, i) => marker.toggleAttribute('data-active', i === index));
    }
    show(current);

    // One clock for every scene, including hidden neighbours. Revealing a layer
    // or completing a gesture never restarts its idle phase.
    const motionOrigin = performance.now();
    let idleFrame = 0;
    function floatLayers(now: number) {
      const seconds = (now - motionOrigin) / 1000;
      stage.style.setProperty('--character-float', `${Math.sin(seconds * Math.PI * 2 / 6) * 9}px`);
      stage.style.setProperty('--background-float', `${Math.sin(seconds * Math.PI * 2 / 8) * -4}px`);
      idleFrame = requestAnimationFrame(floatLayers);
    }
    function updateMotionPreference() {
      cancelAnimationFrame(idleFrame);
      stage.style.removeProperty('--character-float');
      stage.style.removeProperty('--background-float');
      if (!reduced.matches) idleFrame = requestAnimationFrame(floatLayers);
    }
    reduced.addEventListener('change', updateMotionPreference);
    updateMotionPreference();

    function reset(entry: HTMLElement) {
      delete entry.dataset.curtain;
      delete entry.dataset.entering;
      entry.style.removeProperty('--curtain-cut');
      entry.style.removeProperty('--character-shift');
    }

    function render(step: number, amount: number) {
      const outgoing = entries[current];
      if (step !== direction) {
        if (direction) {
          entries[incomingIndex].hidden = true;
          reset(entries[incomingIndex]);
        }
        direction = step;
        incomingIndex = (current + step + entries.length) % entries.length;
        entries[incomingIndex].dataset.entering = '';
        entries[incomingIndex].hidden = false;
        outgoing.dataset.curtain = step > 0 ? 'up' : 'down';
      }
      progress = amount;
      // One progress value drives opposing masks inside fixed panel windows.
      // Incoming art and copy remain opaque beneath their outgoing counterparts.
      outgoing.style.setProperty('--curtain-cut', `${amount * 100}%`);
      // SVG units keep the small depth movement proportional to the artwork.
      // The incoming character reaches zero exactly when its curtain completes.
      outgoing.style.setProperty('--character-shift', `${-step * amount * 40}px`);
      entries[incomingIndex].style.setProperty('--character-shift', `${step * (1 - amount) * 40}px`);
    }

    function settle(step: number, commit: boolean) {
      if (moving) return;
      clearTimeout(wheelTimer);
      wheelTimer = undefined;
      moving = true;
      const outgoing = entries[current];
      if (commit && outgoing.contains(document.activeElement)) stage.focus({ preventScroll: true });
      const from = progress;
      const target = commit ? 1 : 0;
      const finish = () => {
        if (commit) current = (current + step + entries.length) % entries.length;
        show(current);
        entries.forEach(reset);
        direction = 0;
        progress = 0;
        moving = false;
      };
      if (reduced.matches || from === target) {
        finish();
        return;
      }
      const duration = 150 + 370 * Math.abs(target - from);
      const started = performance.now();
      const frame = (now: number) => {
        const time = Math.min(1, (now - started) / duration);
        render(step, from + (target - from) * (1 - (1 - time) ** 3));
        if (time < 1) requestAnimationFrame(frame);
        else finish();
      };
      requestAnimationFrame(frame);
    }

    stage.addEventListener('wheel', (event) => {
      if (event.ctrlKey || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
      event.preventDefault();
      const now = performance.now();
      const fresh = now - lastWheel > 180;
      lastWheel = now;
      if (moving || drag) return;
      if (fresh) wheelTotal = 0;
      wheelTotal += event.deltaY * (event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? stage.clientHeight : 1);
      const step = Math.sign(wheelTotal) || direction || 1;
      if (!reduced.matches) render(step, Math.min(1, Math.abs(wheelTotal) / stage.clientHeight));
      clearTimeout(wheelTimer);
      // Accumulate trackpad reversals before releasing, rather than latching
      // the first direction. A wheel notch still completes one scene.
      wheelTimer = setTimeout(() => {
        settle(step, Math.abs(wheelTotal) >= 34);
        wheelTotal = 0;
      }, 180);
    }, { passive: false });

    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch' || !event.isPrimary || moving || wheelTimer !== undefined) return;
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY,
        lastY: event.clientY, time: event.timeStamp, velocity: 0, locked: false };
    });
    stage.addEventListener('pointermove', (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      const distance = drag.y - event.clientY;
      const horizontal = Math.abs(drag.x - event.clientX);
      if (!drag.locked) {
        if (horizontal > 9 && horizontal > Math.abs(distance)) {
          drag = undefined;
          return;
        }
        if (Math.abs(distance) < 9) return;
        drag.locked = true;
        stage.setPointerCapture(event.pointerId);
      }
      const elapsed = Math.max(1, event.timeStamp - drag.time);
      drag.velocity = (drag.lastY - event.clientY) / elapsed;
      drag.lastY = event.clientY;
      drag.time = event.timeStamp;
      if (!reduced.matches) render(Math.sign(distance) || direction || 1, Math.min(1, Math.abs(distance) / stage.clientHeight));
    });

    function release(event: PointerEvent) {
      if (!drag || drag.id !== event.pointerId) return;
      const gesture = drag;
      drag = undefined;
      if (!gesture.locked) return;
      const distance = gesture.y - gesture.lastY;
      const step = Math.sign(distance) || direction || 1;
      const speed = event.timeStamp - gesture.time < 100 ? gesture.velocity * step : 0;
      const commit = event.type === 'pointerup' &&
        (Math.abs(distance) >= stage.clientHeight * .25 || (Math.abs(distance) >= 24 && speed > .45));
      settle(step, commit);
    }
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);
    stage.addEventListener('lostpointercapture', (event) => {
      if (event.target === stage) release(event);
    });

    stage.addEventListener('keydown', (event) => {
      const step = { ArrowUp: -1, ArrowDown: 1, PageUp: -1, PageDown: 1 }[event.key];
      if (moving || drag || !step || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      if (direction && direction !== step) render(step, 0);
      settle(step, true);
    });
  }
</script>

<style>
  :global(.immersive-clients) { background: #164c50; }
  :global(.immersive-clients .site-bar) {
    position: fixed;
    inset: 0 0 auto;
    height: calc(56px + env(safe-area-inset-top));
    background: rgb(17 26 29 / .72);
    color: white;
    border: 0;
  }
  :global(.immersive-clients .bar-link),
  :global(.immersive-clients .brand),
  :global(.immersive-clients .menu-btn),
  :global(.immersive-clients .wordmark .nassu) { color: white; }
  :global(.immersive-clients .wordmark .katou) { color: #a3f0db; }
  :global(.immersive-clients .bar-link[aria-current]),
  :global(.immersive-clients .bar-link:hover) { color: #132c30; background: #eaf7f4; }
  .gallery-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .client-gallery { position: relative; }
  .client-reel[data-ready] {
    position: relative;
    height: 100svh;
    height: 100dvh;
    overflow: clip;
    isolation: isolate;
    touch-action: pan-x pinch-zoom;
  }
  .client-reel:focus-visible { outline: 2px solid white; outline-offset: -4px; }
  .client-entry {
    --art-start: 33%;
    --copy-end: 41%;
    position: relative;
    min-height: 100svh;
    color: white;
  }
  [data-ready] .client-entry { position: absolute; inset: 0; min-height: 0; }
  /* Keep articles out of a stacking context: both copy windows must sit above
     both art windows along the diagonal, even when the reveals disagree. */
  .art-window { z-index: 0; }
  .copy-window { z-index: 2; }
  [data-curtain] .art-window { z-index: 1; }
  [data-curtain] .copy-window { z-index: 3; }
  [data-curtain="up"] .client-art,
  [data-curtain="down"] .client-copy { clip-path: inset(0 0 var(--curtain-cut, 0%) 0); }
  [data-curtain="down"] .client-art,
  [data-curtain="up"] .client-copy { clip-path: inset(var(--curtain-cut, 0%) 0 0 0); }
  .art-window, .copy-window { position: absolute; overflow: clip; }
  .art-window { inset: 0 0 0 var(--art-start); }
  .copy-window { inset: 0 auto 0 0; width: var(--copy-end); clip-path: polygon(0 0, 100% 0, 80.5% 100%, 0 100%); }
  .client-art, .client-copy { height: 100%; }
  .client-art { background: var(--backdrop); }
  .client-art svg { display: block; width: 100%; height: 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .character-depth { transform: translateY(calc(var(--character-float, 0px) + var(--character-shift, 0px))); }
    .art-depth { transform: translateY(var(--background-float, 0px)); }
  }
  .client-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    gap: .75rem;
    padding: max(4rem, env(safe-area-inset-top)) 20% 3rem clamp(1.5rem, 4vw, 5rem);
    background: var(--panel);
  }
  .client-copy h1 { font-size: clamp(2.8rem, 7vw, 8rem); line-height: .95; letter-spacing: -.075em; margin: 0; }
  .client-copy a { color: white; font-size: clamp(1rem, 1.7vw, 1.65rem); text-decoration: underline; text-underline-offset: .3em; }
  .reel-controls { position: absolute; inset: auto max(1rem, env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom)) auto; z-index: 2; pointer-events: none; }
  .position-marks { display: flex; align-items: center; gap: 5px; padding: 7px; border-radius: 100px; background: #152328a6; }
  .position-marks span { width: 5px; height: 5px; border-radius: 100px; background: #ffffff80; transition: width .25s, background-color .25s; }
  .position-marks [data-active] { width: 16px; background: white; }
  @media (max-width: 680px) {
    .art-window { inset: 0 0 31%; }
    .copy-window { inset: 58% 0 0; width: auto; clip-path: polygon(0 0, 100% 21%, 100% 100%, 0 100%); }
    .client-copy { justify-content: start; padding: clamp(2.5rem, 9vh, 5rem) 1.25rem 1.25rem; }
    .client-copy h1 { font-size: clamp(2.65rem, 12vw, 5rem); }
  }
  @media (prefers-reduced-motion: reduce) { .position-marks span { transition: none; } }
</style>
