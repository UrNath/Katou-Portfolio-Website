---
import '../styles/global.css';
import '../styles/scroll-portfolio.css';
import '@fontsource/bowlby-one/latin-400.css';
import '@fontsource-variable/outfit/index.css';
import '../styles/poster.css';
import '@fontsource/barlow-condensed/latin-700-italic.css';
import '@fontsource/barlow-condensed/latin-800-italic.css';
import '@fontsource/barlow-condensed/latin-900-italic.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/chakra-petch/latin-600.css';
import '@fontsource/chakra-petch/latin-700.css';
import '../styles/skin.css';
import SiteBar from './SiteBar.astro';
import SiteFooter from './SiteFooter.astro';
import { site } from '../data/site';
import { loadServicePrices } from '../lib/services';
import nameUrl from '@fontsource/barlow-condensed/files/barlow-condensed-latin-900-italic.woff2?url';
import bodyUrl from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import uiUrl from '@fontsource/chakra-petch/files/chakra-petch-latin-700-normal.woff2?url';

interface Props {
  title?: string;
  immersive?: boolean;
  description?: string;
}

const { title, immersive = false, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const { editing, web } = await loadServicePrices();
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1015" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={nameUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={uiUrl} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <slot name="head" />
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (reduce || (conn && conn.saveData)) document.documentElement.classList.add('poster-only');
      })();
    </script>
    <script is:inline>
      // Effects tier. Old or busy devices get "fx-lite": same layout and motion, cheaper paint
      // (no blur, no big halftone fills, no stacked glow filters, simpler cut-in and page wipe).
      (function () {
        var root = document.documentElement, n = navigator;
        var lite = (n.hardwareConcurrency && n.hardwareConcurrency <= 4) || (n.deviceMemory && n.deviceMemory <= 4);
        try { var saved = localStorage.getItem('nk-fx'); if (saved === 'lite') lite = true; } catch (e) {}
        if (lite) root.classList.add('fx-lite');
      })();
    </script>
    <script is:inline>
      // Page switch: three slanted bands sweep across with the next page's name, the browser
      // navigates while the screen is covered, and the new page uncovers left to right.
      // Transforms only, so it stays smooth on slow devices.
      (function () {
        var routes = { '/': ['Home', '01', '#2f6fe0'], '/works': ['Works', '02', '#ff5b34'], '/clients': ['Clients', '03', '#8fc8ff'], '/pricing': ['Pricing', '04', '#2f6fe0'], '/contact': ['Contact', '05', '#2f6fe0'], '/terms': ['Terms', '06', '#f3c443'] };
        var norm = function (p) { return p.replace(/\/+$/, '') || '/'; };
        var reduce = function () { return matchMedia('(prefers-reduced-motion: reduce)').matches; };
        var root = document.documentElement, busy = false, KEY = 'nk-wipe';
        var EASE = 'cubic-bezier(.77,0,.18,1)';
        function build(r) {
          var o = document.createElement('div');
          o.className = 'nk-wipe';
          o.setAttribute('aria-hidden', 'true');
          o.style.setProperty('--wc', r[2]);
          o.innerHTML = '<i class="w1"></i><i class="w2"></i><i class="w3"><b><small>Loading \u00b7 ' + r[1] + '</small><span>' + r[0] + '</span></b></i>';
          return o;
        }
        function bands(o) { return Array.prototype.slice.call(o.querySelectorAll('i')); }
        var SK = 'skewX(-18deg) ';
        function sweep(o, from, to, dur) {
          var lite = root.classList.contains('fx-lite');
          var list = bands(o);
          return Promise.all(list.map(function (b, k) {
            if (lite && k < 2) { b.style.display = 'none'; return Promise.resolve(); }
            return b.animate([{ transform: SK + 'translate3d(' + from + '%,0,0)' }, { transform: SK + 'translate3d(' + to + '%,0,0)' }],
              { duration: dur, delay: lite ? 0 : k * 50, easing: EASE, fill: 'forwards' }).finished.catch(function () {});
          }));
        }
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || busy || reduce()) return;
          var a = e.target && e.target.closest && e.target.closest('a[href]');
          if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
          var u = new URL(a.href, location.href);
          if (u.origin !== location.origin) return;
          var to = norm(u.pathname);
          if (!(to in routes) || (to === norm(location.pathname))) return;
          e.preventDefault();
          busy = true;
          var o = build(routes[to]);
          root.append(o);
          document.querySelectorAll('main').forEach(function (m) { m.classList.add('nk-leaving'); });
          sweep(o, -150, 0, 480).then(function () {
            try { sessionStorage.setItem(KEY, JSON.stringify({ p: to, t: Date.now() })); } catch (err) {}
            location.href = u.href;
          });
        }, true);
        addEventListener('pageshow', function (e) {
          if (!e.persisted) return;
          busy = false;
          document.querySelectorAll('.nk-wipe').forEach(function (n) { n.remove(); });
          document.querySelectorAll('main.nk-leaving').forEach(function (m) { m.classList.remove('nk-leaving'); });
        });
        addEventListener('pageswap', function (e) { if (e.viewTransition && busy) e.viewTransition.skipTransition(); });
        // Incoming: the bands are already covering the page, then sweep off to the right.
        var s0 = null;
        try { s0 = JSON.parse(sessionStorage.getItem(KEY)); sessionStorage.removeItem(KEY); } catch (e) {}
        if (s0 && Date.now() - s0.t < 6000 && !reduce() && routes[s0.p]) {
          addEventListener('pagereveal', function (e) { if (e.viewTransition) e.viewTransition.skipTransition(); });
          var o = build(routes[s0.p]);
          o.classList.add('is-covering');
          root.append(o);
          root.classList.add('nk-arrive');
          var opened = false;
          var open = function () {
            if (opened) return; opened = true;
            o.classList.remove('is-covering');
            sweep(o, 0, 150, 560).then(function () { o.remove(); setTimeout(function () { root.classList.remove('nk-arrive'); }, 300); });
          };
          var go = function () { (document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve()).then(function () { setTimeout(open, 60); }, open); };
          if (document.readyState !== 'loading') go(); else { document.addEventListener('DOMContentLoaded', go); }
          setTimeout(open, 1600);
        }
      })();
    </script>
  </head>
  <body class:list={['clean-portfolio', immersive ? 'immersive-clients' : 'poster']}>
    <a class="skip" href="#main">Skip to content</a>
    <SiteBar pathname={pathname} prices={{ editing, web }} />
    <main id="main">
      <slot />
    </main>
    {!immersive && <SiteFooter />}
    <script is:inline>
      document.addEventListener('click', function (event) {
        var target = event.target && event.target.closest ? event.target : null;
        if (!target || !target.closest) return;
        if (target.closest('[data-pause]')) return;
        var opener = target.closest('[data-open-clip]');
        if (!opener) return;
        window.__nkClip = opener.getAttribute('data-open-clip');
      });
    </script>
    <script>
    import '../lib/flick';
    import '../lib/fx';
  </script>
</body>
</html>
