---
import '../styles/global.css';
import '../styles/scroll-portfolio.css';
import '@fontsource/bowlby-one/latin-400.css';
import '@fontsource-variable/outfit/index.css';
import '../styles/poster.css';
import SiteBar from './SiteBar.astro';
import SiteFooter from './SiteFooter.astro';
import { site } from '../data/site';
import { loadServicePrices } from '../lib/services';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource/geist-mono/files/geist-mono-latin-500-normal.woff2?url';
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';

interface Props {
  title?: string;
  immersive?: boolean;
  description?: string;
}

const { title, immersive = false, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const { editing, web } = await loadServicePrices();
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FCFCFA" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <slot name="head" />
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (reduce || (conn && conn.saveData)) document.documentElement.classList.add('poster-only');
      })();
    </script>
    <script is:inline>
      // Card-push page transition: tell the browser which way we are moving through the main pages.
      (function () {
        var order = ['/', '/works', '/pricing', '/terms', '/contact'];
        var at = function (url) { var p = new URL(url, location.href).pathname.replace(/\/+$/, '') || '/'; return order.indexOf(p); };
        var tag = function (event, from, to, arriving) {
          if (!event.viewTransition || from < 0 || to < 0 || from === to) return;
          event.viewTransition.types.add(to > from ? 'vt-forward' : 'vt-back');
          var root = document.documentElement;
          var names = arriving ? ['vt-push', 'vt-arrive'] : ['vt-push'];
          root.classList.add.apply(root.classList, names);
          var clear = function () { root.classList.remove.apply(root.classList, names); };
          event.viewTransition.finished.then(clear, clear);
        };
        addEventListener('pageswap', function (event) {
          if (event.activation && event.activation.entry) tag(event, at(location.href), at(event.activation.entry.url));
        });
        addEventListener('pagereveal', function (event) {
          var a = window.navigation && navigation.activation;
          if (a && a.from && a.entry) tag(event, at(a.from.url), at(a.entry.url), true);
        });
      })();
    </script>
  </head>
  <body class:list={['clean-portfolio', immersive ? 'immersive-clients' : 'poster']}>
    <a class="skip" href="#main">Skip to content</a>
    <SiteBar pathname={pathname} prices={{ editing, web }} />
    <main id="main">
      <slot />
    </main>
    {!immersive && <SiteFooter />}
    <script is:inline>
      document.addEventListener('click', function (event) {
        var target = event.target && event.target.closest ? event.target : null;
        if (!target || !target.closest) return;
        if (target.closest('[data-pause]')) return;
        var opener = target.closest('[data-open-clip]');
        if (!opener) return;
        window.__nkClip = opener.getAttribute('data-open-clip');
      });
    </script>
    <script>
    import '../lib/flick';
  </script>
</body>
</html>
