---
import ClipCard from './ClipCard.astro';
import type { ClipRecord } from '../lib/clips';
interface Props { clips: ClipRecord[]; initialId: string }
const { clips, initialId } = Astro.props;
const samples = clips.slice(0, 5);
const initial = Math.max(0, samples.findIndex((clip) => clip.id === initialId));
function offset(index: number) {
  const half = Math.floor(samples.length / 2);
  return ((index - initial + samples.length + half) % samples.length) - half;
}
---
<div class="sample-carousel" data-carousel data-initial={initial} role="region" aria-roledescription="carousel" aria-label="Featured video samples" tabindex="0">
  <div class="carousel-stage" data-carousel-stage>
    {samples.map((clip, index) => (
      <div class="carousel-card" data-carousel-card data-index={index} data-position={offset(index)} data-active={index === initial ? 'true' : 'false'} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${samples.length}: ${clip.title}`} aria-hidden={Math.abs(offset(index)) > 1 ? 'true' : 'false'} inert={Math.abs(offset(index)) > 1}>
        <ClipCard clip={clip} variant="hero" previewHero={index === initial} sizes="(min-width: 960px) 260px, 40vw" />
      </div>
    ))}
  </div>
  <div class="carousel-controls">
    <button class="carousel-arrow" type="button" data-carousel-prev aria-label="Previous sample">←</button>
    <div class="carousel-indicators" role="group" aria-label="Choose a sample">
      {samples.map((clip, index) => <button class="carousel-dot" type="button" data-carousel-dot={index} aria-label={`Show sample ${index + 1}: ${clip.title}`} aria-pressed={index === initial}><span></span></button>)}
    </div>
    <button class="carousel-arrow" type="button" data-carousel-next aria-label="Next sample">→</button>
  </div>
  <p class="carousel-current" data-carousel-current aria-live="polite" aria-atomic="true">{initial + 1} / {samples.length} · {samples[initial]?.creator}</p>
  <p class="carousel-help">Swipe or use the arrows to explore. Tap the centre video to play.</p>
</div>
<script>
  import { mountCarousel } from '../lib/featured-carousel';
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(mountCarousel);
</script>
