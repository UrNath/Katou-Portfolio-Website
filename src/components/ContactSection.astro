---
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';
import StatusChip from './StatusChip.astro';
import { contactServices, guidelines } from '../data/contact';
import { status } from '../data/status';
import { isPlaceholder, site, socials } from '../data/site';
const discord = socials.find((item) => item.id === 'discord');
---

  <article class="contact">
    <section class="dc-card" aria-labelledby="dc-title">
      <p class="dc-kicker">Fastest way to reach me</p>
      <h2 id="dc-title" class="dc-title">Message me on Discord</h2>
      <div class="dc-tag-row">
        <span class="dc-at" aria-hidden="true">@</span>
        <code class="dc-tag" id="dc-tag" aria-label="Discord username nassukatou">nassukatou</code>
      </div>
      <div class="dc-actions">
        <a class="pc-btn pc-btn-gold" href={discord?.href} target="_blank" rel="noopener noreferrer">Open Discord</a>
        <button class="pc-btn pc-btn-white" type="button" id="copy-tag">Copy tag</button>
        <span class="copied" id="copied-tag" role="status" hidden>Copied</span>
      </div>
      <div class="status-row" aria-label="Service status">
        <span>Editing <StatusChip status={status.editing} /></span>
        <span>Web design <StatusChip status={status.webDesign} /></span>
      </div>
    </section>

    <p class="dc-or">Prefer email? Use the form below. It opens a draft in your email app and nothing is stored on a server.</p>

    <section class="surface-card guidelines">
      <h2>Before you write</h2>
      <ul>
        {guidelines.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <form
      id="contact-form"
      action={`mailto:${site.email}`}
      method="post"
      enctype="text/plain"
    >
      <label class="field">
        <span>Name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label class="field">
        <span>Handle / channel</span>
        <input name="handle" autocomplete="nickname" required />
      </label>
      <label class="field">
        <span>Service</span>
        <select name="service" id="service">
          {contactServices.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </label>
      <label class="field">
        <span>Links</span>
        <input name="links" type="text" inputmode="url" placeholder="VOD or reference (optional)" />
      </label>
      <label class="field">
        <span>Message</span>
        <textarea name="message" required></textarea>
      </label>
      <p class="form-hint">This opens a draft in your email app. It does not send mail by itself.</p>
      <div class="block">
        <button class="cta" type="submit">Email Katou</button>
      </div>
      <p class="form-status" id="form-status" role="status"></p>
      <textarea class="draft" id="draft" hidden readonly></textarea>
    </form>

    <section class="block">
      <h2 class="kicker">Elsewhere</h2>
      <div class="social-row">
        {
          socials.map((item) => (
            <a
              class="icon-btn"
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={isPlaceholder(item.href) ? `${item.label}, placeholder link` : item.label}
            >
              <BrandIcon name={item.id} />
            </a>
          ))
        }
      </div>
      <div class="copy-row">
        <a class="copy-email" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="copy-btn" type="button" id="copy-email">
          <Icon name="copy" size={14} />
          Copy
        </button>
        <span class="copied" id="copied" hidden>Copied</span>
      </div>
    </section>
  </article>
  <script define:vars={{ email: site.email }}>
    const params = new URLSearchParams(location.search);
    const requested = params.get('service');
    const select = document.querySelector('#service');
    if (requested && select instanceof HTMLSelectElement) {
      const match = Array.from(select.options).some((option) => option.value === requested);
      if (match) select.value = requested;
    }

    const form = document.querySelector('#contact-form');
    const status = document.querySelector('#form-status');
    const draft = document.querySelector('#draft');
    if (form instanceof HTMLFormElement && status && draft instanceof HTMLTextAreaElement) {
      form.addEventListener('submit', (event) => {
        if (!form.reportValidity()) return;
        event.preventDefault();
        const data = new FormData(form);
        const body = [
          `Name: ${String(data.get('name') ?? '')}`,
          `Handle: ${String(data.get('handle') ?? '')}`,
          `Service: ${String(data.get('service') ?? '')}`,
          `Links: ${String(data.get('links') || '(none)')}`,
          '',
          String(data.get('message') ?? ''),
        ].join('\n');
        draft.hidden = false;
        draft.value = body;
        status.textContent = 'Opening your email app with this draft. If nothing opens, copy the message below.';
        const href = `mailto:${email}?subject=${encodeURIComponent('Commission request')}&body=${encodeURIComponent(body)}`;
        window.location.href = href;
      });
    }

    const copyTag = document.querySelector('#copy-tag');
    const copiedTag = document.querySelector('#copied-tag');
    copyTag?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('nassukatou');
      } catch {
        const range = document.createRange();
        const node = document.querySelector('#dc-tag');
        if (node) { range.selectNodeContents(node); const sel = getSelection(); sel?.removeAllRanges(); sel?.addRange(range); document.execCommand('copy'); }
      }
      if (copiedTag instanceof HTMLElement) {
        copiedTag.hidden = false;
        window.setTimeout(() => { copiedTag.hidden = true; }, 1600);
      }
    });

    const copyBtn = document.querySelector('#copy-email');
    const copied = document.querySelector('#copied');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const fallback = document.createElement('textarea');
        fallback.value = email;
        document.body.append(fallback);
        fallback.select();
        document.execCommand('copy');
        fallback.remove();
      }
      if (copied instanceof HTMLElement) {
        copied.hidden = false;
        window.setTimeout(() => {
          copied.hidden = true;
        }, 1600);
      }
    });
  </script>

