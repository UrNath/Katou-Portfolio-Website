---
import { siDiscord, siTiktok, siX, siYoutube } from 'simple-icons';

const brands = {
  discord: siDiscord,
  youtube: siYoutube,
  tiktok: siTiktok,
  x: siX,
} as const;

interface Props {
  name: keyof typeof brands;
  size?: number;
}

const { name, size = 18 } = Astro.props;
const icon = brands[name];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="currentColor"
>
  <path d={icon.path}></path>
</svg>
