---
/** Icon for a content type on Works: tall phone = short-form, wide screen = long-form, picture = thumbnails. */
interface Props {
  type: 'short' | 'long' | 'thumbnail';
  size?: number;
}
const { type, size = 24 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {type === 'short' && (<><rect x="7" y="2.5" width="10" height="19" rx="2.2" /><path d="M11 10l3 2-3 2z" /></>)}
  {type === 'long' && (<><rect x="2.5" y="6" width="19" height="12" rx="2.2" /><path d="M10.5 9.6l3.8 2.4-3.8 2.4z" /></>)}
  {type === 'thumbnail' && (<><rect x="3" y="4" width="18" height="16" rx="2.2" /><circle cx="9" cy="10" r="1.6" /><path d="M4 18l5.5-5 4 3.5L16 14l4 4" /></>)}
</svg>
